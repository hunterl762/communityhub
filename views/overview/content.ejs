<% const o=overview;const departmentStyle=name=>/sheriff/i.test(name||'')?'sheriff':/fire|ems|medical/i.test(name||'')?'fire':/dispatch|communications/i.test(name||'')?'communications':'police'; %>
<div class="live-caption"><span class="live-dot" aria-hidden="true"></span><span role="status" data-overview-notice>Updated <%= new Date(o.updatedAt).toLocaleTimeString() %> · live data refreshes every 15 seconds</span></div>
<section class="stats overview-kpis" aria-label="Community at a glance"><div><span class="public-stat-label">Server availability</span><b><%= o.online %> / <%= o.servers.length %></b><span>Servers reporting online</span></div><div><span class="public-stat-label">Connected players</span><b><%= o.players %></b><span>Across online servers</span></div><div><span class="public-stat-label">Active units</span><b><%= o.units.length %></b><span>Seen in the last 90 seconds</span></div><div><span class="public-stat-label">My patrol</span><b><%= o.patrol?'On duty':'Off duty' %></b><span><%= o.patrol?o.patrol.server_name||'Community':'Ready when you are' %></span></div></section>
<div class="overview-grid"><section class="panel"><div class="panel-heading"><div><div class="eyebrow">LIVE OPERATIONS</div><h2>Active unit roster</h2></div><a href="/fivem">Patrol controls ↗</a></div><% if(o.units.length){ %><div class="table-scroll"><table class="community-table"><thead><tr><th>Unit</th><th>Department</th><th>Status</th><th>Server</th></tr></thead><tbody><% o.units.slice(0,30).forEach(u=>{ %><tr><td><span class="unit-id"><%= u.callsign||'Unassigned' %></span><br><%= u.player_name||'Member' %></td><td><span class="department-tag <%= departmentStyle(u.department) %>"><%= u.department||'Unassigned' %></span></td><td><%= (u.duty_status||'available').replaceAll('_',' ') %></td><td><%= u.server_name %></td></tr><% }) %></tbody></table></div><% if(o.units.length>30){ %><p class="muted">Showing 30 of <%= o.units.length %> active units.</p><% } %><% }else{ %><div class="empty-state">No units are currently reporting in. Connected units appear here automatically.</div><% } %></section>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">INTEGRATION HEALTH</div><h2>Server availability</h2></div><a href="/fivem/status">Status history ↗</a></div><div class="overview-list"><% o.servers.forEach(s=>{ %><article class="overview-item"><div class="server-title"><strong><%= s.name %></strong><span class="status-badge <%= Number(s.live)?'online':'offline' %>"><%= Number(s.live)?'Online':'Offline' %></span></div><small><%= s.current_players||0 %> / <%= s.max_players %> players · heartbeat <%= s.last_heartbeat_at?new Date(s.last_heartbeat_at).toLocaleTimeString():'not received' %></small><% if(Number(s.live)&&s.game_clock_at&&Date.now()-new Date(s.game_clock_at).getTime()<90000){ %><small>Game time <%= String(s.game_hours).padStart(2,'0') %>:<%= String(s.game_minutes).padStart(2,'0') %></small><% } %></article><% }) %><% if(!o.servers.length){ %><p class="empty-state">No enabled FiveM servers configured.</p><% } %></div><p class="muted"><small>Availability reflects integration heartbeats.</small></p></section></div>
<div class="overview-grid overview-secondary"><section class="panel"><div class="panel-heading"><div><div class="eyebrow">COMMUNITY SCHEDULE</div><h2>Coming up</h2></div><a href="/calendar">Calendar ↗</a></div><div class="overview-list"><% o.training.forEach(t=>{ %><a class="overview-item" href="/training"><strong><%= t.title %></strong><small>Training · <%= new Date(t.start_at).toLocaleString() %> · <%= t.location||'Location TBA' %></small></a><% }) %><% o.calendar.forEach(e=>{ %><a class="overview-item" href="/calendar"><strong><%= e.title %></strong><small><%= e.event_type||'Event' %> · <%= new Date(e.start_at).toLocaleString() %></small></a><% }) %><% if(!o.calendar.length&&!o.training.length){ %><p class="empty-state">No upcoming training or events.</p><% } %></div></section>
<section class="panel"><div class="panel-heading"><div><div class="eyebrow">MY COMMUNITY</div><h2>Applications & duty</h2></div><a href="/applications">Applications ↗</a></div><div class="overview-list"><% if(o.patrol){ %><a class="overview-item" href="/fivem"><strong>Current patrol · <%= o.patrol.callsign||'On duty' %></strong><small><%= o.patrol.department_name||'Unassigned' %> · since <%= new Date(o.patrol.clocked_in_at).toLocaleString() %></small></a><% } %><% o.applications.forEach(a=>{ %><a class="overview-item" href="/applications"><strong><%= a.title %></strong><small>#<%= a.id %> · <%= a.status.replaceAll('_',' ') %></small></a><% }) %><% if(!o.applications.length&&!o.patrol){ %><p class="empty-state">Your applications and current patrol will appear here.</p><% } %></div><% if(o.review){ %><a class="overview-item" href="/admin"><strong>Staff review queue ↗</strong><small><%= o.review.applications %> submitted applications · <%= o.review.reports %> open reports</small></a><% } %></section></div>
<% if(o.announcements.length){ %><section class="panel overview-secondary"><div class="panel-heading"><div><div class="eyebrow">COMMUNITY BULLETIN</div><h2>Announcements</h2></div></div><div class="overview-list"><% o.announcements.forEach(a=>{ %><article class="overview-item"><strong><%= a.title %><% if(a.priority!=='info'){ %> · <span class="pill"><%= a.priority %></span><% } %></strong><p class="preserve-lines muted"><%= a.message %></p></article><% }) %></div></section><% } %>

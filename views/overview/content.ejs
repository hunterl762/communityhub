<% const o=overview;const departmentStyle=name=>/sheriff/i.test(name||'')?'sheriff':/fire|ems|medical/i.test(name||'')?'fire':/dispatch|communications/i.test(name||'')?'communications':'police';const pendingApps=o.review?o.review.applications:o.applications.length;const openReports=o.review?o.review.reports:0; %>
<div class="command-livebar"><span><span class="live-dot" aria-hidden="true"></span><span role="status" data-overview-notice><%= o.online %> of <%= o.servers.length %> FiveM integrations reporting · updated <%= new Date(o.updatedAt).toLocaleTimeString() %></span></span><span>Refreshes every 15 seconds</span></div>
<nav class="command-metrics" aria-label="Operational summary"><a class="command-metric" href="/fivem/status"><span>FiveM servers</span><b><%= o.online %>/<%= o.servers.length %></b><small>Reporting online</small></a><a class="command-metric" href="/fivem"><span>Connected players</span><b><%= o.players %></b><small>Across online servers</small></a><a class="command-metric" href="/fivem"><span>Staff / units active</span><b><%= o.units.length %></b><small>Seen in the last 90 seconds</small></a><a class="command-metric" href="/applications"><span>Applications</span><b><%= pendingApps %></b><small><%= o.review?'Awaiting staff review':'Recent submissions' %></small></a><a class="command-metric" href="/reports"><span>Open reports</span><b><%= openReports %></b><small><%= o.review?'Requires attention':'Staff access required' %></small></a></nav>
<div class="command-layout"><section class="command-panel command-table"><div class="panel-heading"><div><div class="eyebrow">LIVE OPERATIONS</div><h2>Active roster</h2></div><a href="/fivem">Open operations ↗</a></div><% if(o.units.length){ %><div class="table-scroll"><table class="community-table"><thead><tr><th>Unit</th><th>Department</th><th>Status</th><th>Server</th></tr></thead><tbody><% o.units.slice(0,30).forEach(u=>{ %><tr><td><span class="unit-id"><%= u.callsign||'Unassigned' %></span><br><%= u.player_name||'Member' %></td><td><span class="department-tag <%= departmentStyle(u.department) %>"><%= u.department||'Unassigned' %></span></td><td><%= (u.duty_status||'available').replaceAll('_',' ') %></td><td><%= u.server_name %></td></tr><% }) %></tbody></table></div><% }else{ %><div class="command-empty">No units are currently reporting. Connected units appear here automatically.</div><% } %></section><div class="command-stack"><section class="command-panel"><div class="panel-heading"><div><div class="eyebrow">INTEGRATIONS</div><h2>FiveM health</h2></div><a href="/fivem/status">History ↗</a></div><% o.servers.forEach(s=>{ %><article class="command-row"><div><strong><%= s.name %></strong><small><%= s.current_players||0 %> / <%= s.max_players %> players · heartbeat <%= s.last_heartbeat_at?new Date(s.last_heartbeat_at).toLocaleTimeString():'not received' %></small></div><span class="status-badge <%= Number(s.live)?'online':'offline' %>"><%= Number(s.live)?'Online':'Offline' %></span></article><% }) %><% if(!o.servers.length){ %><div class="command-empty">No enabled FiveM servers are configured.</div><% } %></section><section class="command-panel"><div class="panel-heading"><div><div class="eyebrow">UPCOMING</div><h2>Schedule</h2></div><a href="/calendar">Calendar ↗</a></div><% o.training.slice(0,4).forEach(t=>{ %><a class="command-row" href="/training"><div><strong><%= t.title %></strong><small>Training · <%= new Date(t.start_at).toLocaleString() %> · <%= t.location||'Location TBA' %></small></div><span>↗</span></a><% }) %><% o.calendar.slice(0,4).forEach(e=>{ %><a class="command-row" href="/calendar"><div><strong><%= e.title %></strong><small><%= e.event_type||'Event' %> · <%= new Date(e.start_at).toLocaleString() %></small></div><span>↗</span></a><% }) %><% if(!o.calendar.length&&!o.training.length){ %><div class="command-empty">No upcoming training or events.</div><% } %></section><section class="command-panel"><div class="panel-heading"><div><div class="eyebrow">YOUR STATUS</div><h2>Duty & applications</h2></div></div><% if(o.patrol){ %><a class="command-row" href="/fivem"><div><strong><%= o.patrol.callsign||'On duty' %></strong><small><%= o.patrol.department_name||'Unassigned' %> · since <%= new Date(o.patrol.clocked_in_at).toLocaleString() %></small></div><span>↗</span></a><% }else{ %><a class="command-row" href="/fivem"><div><strong>Off duty</strong><small>Open operations to begin a patrol session.</small></div><span>↗</span></a><% } %><% o.applications.slice(0,3).forEach(a=>{ %><a class="command-row" href="/applications"><div><strong><%= a.title %></strong><small>#<%= a.id %> · <%= a.status.replaceAll('_',' ') %></small></div><span>↗</span></a><% }) %><% if(o.review){ %><a class="command-row" href="/admin"><div><strong>Staff review queue</strong><small><%= o.review.applications %> applications · <%= o.review.reports %> open reports</small></div><span>↗</span></a><% } %></section></div></div>
<% if(o.announcements.length){ %><section class="command-panel command-bulletin"><div class="panel-heading"><div><div class="eyebrow">COMMUNICATIONS</div><h2>Recent announcements</h2></div></div><% o.announcements.forEach(a=>{ %><article class="overview-item"><strong><%= a.title %><% if(a.priority!=='info'){ %> · <span class="pill"><%= a.priority %></span><% } %></strong><p class="preserve-lines muted"><%= a.message %></p></article><% }) %></section><% } %>

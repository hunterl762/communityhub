<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow"><%= communityName %></div><h1>Appearance & tablet features</h1><p>One community identity across the website, tablet and duty HUD.</p><a class="tool-link" href="/admin/website">Customize public pages & link previews →</a></div></section><div class="grid two"><section class="panel"><h2>Community logo</h2><% if(branding.logo){ %><img class="logo-preview" src="<%= branding.logo %>" alt="Current community logo"><% }else{ %><p class="muted">The community initials are displayed until you upload a logo.</p><% } %><form method="post" action="/admin/appearance/logo" enctype="multipart/form-data"><label><span>Logo image · PNG, JPEG or WebP · up to 256 KB</span><input type="file" name="logo" accept="image/png,image/jpeg,image/webp" required></label><button class="btn">Save logo</button></form><% if(branding.logo){ %><form method="post" action="/admin/appearance/logo/remove" class="compact-action"><button class="btn secondary">Use initials instead</button></form><% } %><p class="muted">Stored in SQL. Changes reach the tablet on its next refresh.</p><% if(user.role==='owner'){ %><a class="tool-link" href="/admin#community-settings">Change community name →</a><% } %></section><section class="panel"><h2>In-game features</h2><form method="post" action="/admin/appearance/features"><% [['applications','Website applications'],['hud','Mini duty HUD']].forEach(([key,label])=>{ %><label class="checkbox-label"><input type="checkbox" name="<%= key %>" <%= branding.features[key]?'checked':'' %>><span><%= label %></span></label><% }) %><button class="btn">Save feature settings</button></form><p class="muted">Applications require a linked account and verified community Discord membership. Disabling a feature also blocks its API actions.</p></section></div><%- include('../partials/footer') %>

<%- include('../partials/header') %><%- include('../partials/admin-nav') %>
<% const canConfigure=['admin','management','owner'].includes(user.role); %>
<section class="page-head"><div><div class="eyebrow">COMMUNITY MANAGEMENT</div><h1>Personnel administration</h1><p>Manage departments, review leave requests and keep community records organized.</p></div><a class="btn secondary" href="/personnel">View personnel roster</a></section>
<div class="stats"><div><b><%= departments.length %></b><span>Departments</span></div><div><b><%= certs.length %></b><span>Certifications</span></div><div><b><%= loa.length %></b><span>Pending leave requests</span></div><div><b><%= audit.length %></b><span>Recent audit entries</span></div></div>
<div class="split management-workspace"><section><section class="panel"><h2>Departments & ranks</h2><p class="muted">Expand a department to view its settings and manage ranks.</p><% if(!departments.length){ %><p>No departments yet.</p><% } %>
<% departments.forEach(d=>{ %><details class="admin-disclosure"><summary><strong><%= d.name %></strong><span><%= d.ranks.length %> ranks · <%= d.is_active?'Active':'Inactive' %></span></summary><div class="disclosure-body"><p class="muted">Department head: <%= d.head_name||'Unassigned' %></p>
<% if(canConfigure){ %><form method="post" action="/admin/management/departments/<%= d.id %>/update"><label><span>Department name</span><input name="name" value="<%= d.name %>" required></label><label><span>Description</span><textarea name="description"><%= d.description||'' %></textarea></label><div class="form-grid"><% [['discord_role_id','Main Discord role ID'],['recruit_discord_role_id','Recruit Discord role ID'],['member_discord_role_id','Member Discord role ID']].forEach(([key,label])=>{ %><label><span><%= label %></span><input name="<%= key %>" value="<%= d[key]||'' %>"></label><% }) %></div><label class="checkbox-label"><input type="checkbox" name="is_active" <%= d.is_active?'checked':'' %>> Active department</label><button class="btn">Save department</button></form><% }else{ %><p><%= d.description||'No description provided.' %></p><% } %>
<h3>Ranks</h3><% d.ranks.forEach(r=>{ %><div class="rank-card"><form method="post" action="/admin/management/ranks/<%= r.id %>/update"><div class="form-grid"><label><span>Rank name</span><input name="name" value="<%= r.name %>" required></label><label><span>Display order</span><input type="number" name="sort_order" value="<%= r.sort_order %>"></label></div><label><span>Discord role ID</span><input name="discord_role_id" value="<%= r.discord_role_id||'' %>"></label><label class="checkbox-label"><input type="checkbox" name="is_command" <%= r.is_command?'checked':'' %>> Command rank</label><button class="btn secondary">Save rank</button></form><form class="compact-action" method="post" action="/admin/management/ranks/<%= r.id %>/delete"><button class="nav-link-button danger-text">Delete rank</button></form></div><% }) %>
<details class="admin-disclosure"><summary>Add a rank</summary><form class="disclosure-body" method="post" action="/admin/management/departments/<%= d.id %>/ranks"><label><span>Rank name</span><input name="name" required></label><div class="form-grid"><label><span>Display order</span><input type="number" name="sort_order"></label><label><span>Discord role ID</span><input name="discord_role_id"></label></div><label class="checkbox-label"><input type="checkbox" name="is_command"> Command rank</label><button class="btn secondary">Add rank</button></form></details>
</div></details><% }) %></section>
<% if(canConfigure){ %><section class="panel admin-section"><details class="admin-disclosure"><summary><strong>Create department</strong></summary><form class="disclosure-body" method="post" action="/admin/management/departments"><div class="form-grid"><label><span>Department name</span><input name="name" required></label><label><span>URL slug (optional)</span><input name="slug"></label></div><label><span>Description</span><textarea name="description"></textarea></label><% [['discord_role_id','Main Discord role ID'],['recruit_discord_role_id','Recruit Discord role ID'],['member_discord_role_id','Member Discord role ID']].forEach(([key,label])=>{ %><label><span><%= label %></span><input name="<%= key %>"></label><% }) %><button class="btn">Create department</button></form></details></section><% } %>
<section class="panel admin-section"><h2>Certifications</h2><% certs.forEach(c=>{ %><div class="admin-row"><strong><%= c.name %></strong><span class="muted"><%= c.department_name||'Community-wide' %></span></div><% }) %><% if(!certs.length){ %><p class="muted">No certifications yet.</p><% } %><details class="admin-disclosure"><summary>Add certification</summary><form class="disclosure-body" method="post" action="/admin/management/certifications"><label><span>Name</span><input name="name" required></label><div class="form-grid"><label><span>Department (optional)</span><select name="department_id"><option value="">Community-wide</option><% departments.forEach(d=>{ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></label><label><span>Expires after days (optional)</span><input type="number" name="expires_after_days" min="1"></label></div><label><span>Description</span><textarea name="description"></textarea></label><button class="btn">Create certification</button></form></details></section></section>
<aside><section class="panel"><h2>Leave request inbox</h2><% if(!loa.length){ %><p class="muted">All caught up. No pending leave requests.</p><% } %><% loa.forEach(l=>{ %><article class="review-answer"><strong><%= l.display_name||l.discord_username %></strong><p><%= new Date(l.start_date).toLocaleDateString() %> – <%= new Date(l.end_date).toLocaleDateString() %></p><p class="preserve-lines"><%= l.reason %></p><form method="post" action="/admin/management/loa/<%= l.id %>"><label><span>Review note</span><textarea name="review_note"></textarea></label><div class="form-grid"><button class="btn" name="status" value="approved">Approve</button><button class="btn secondary" name="status" value="denied">Deny</button></div></form></article><% }) %></section><section class="panel admin-section"><h2>Recent audit activity</h2><div class="audit-feed"><% audit.forEach(a=>{ %><article class="staff-note"><strong><%= a.action %></strong><p><%= a.display_name||'System' %> · <%= a.entity_type||'' %> <%= a.entity_id||'' %></p><small><%= new Date(a.created_at).toLocaleString() %></small></article><% }) %></div><% if(!audit.length){ %><p class="muted">No recent activity.</p><% } %></section></aside></div><%- include('../partials/footer') %>

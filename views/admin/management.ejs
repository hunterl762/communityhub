<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">COMMUNITY MANAGEMENT</div><h1>Personnel Administration</h1><p>Departments, ranks, certifications, LOA approvals and audit activity.</p></div></section><div class="split"><section><article class="panel"><h2>Departments & Ranks</h2><% departments.forEach(d=>{ %><div class="review-answer"><form method="post" action="/admin/management/departments/<%= d.id %>/update"><label><span>Department</span><input name="name" value="<%= d.name %>" required></label><textarea name="description" placeholder="Description"><%= d.description||'' %></textarea><input name="discord_role_id" value="<%= d.discord_role_id||'' %>" placeholder="Department Discord role ID"><input name="recruit_discord_role_id" value="<%= d.recruit_discord_role_id||'' %>" placeholder="Recruit Discord role ID"><input name="member_discord_role_id" value="<%= d.member_discord_role_id||'' %>" placeholder="Member Discord role ID"><label><input type="checkbox" name="is_active" <%= d.is_active?'checked':'' %>> Active department</label><button class="btn secondary">Save Department</button></form><p class="muted">Department Head: <%= d.head_name||'Unassigned' %></p><h3>Ranks</h3><% d.ranks.forEach(r=>{ %><form method="post" action="/admin/management/ranks/<%= r.id %>/update"><input name="name" value="<%= r.name %>" required><input type="number" name="sort_order" value="<%= r.sort_order %>"><input name="discord_role_id" value="<%= r.discord_role_id||'' %>" placeholder="Discord role ID"><label><input type="checkbox" name="is_command" <%= r.is_command?'checked':'' %>> Command</label><button class="btn secondary">Save Rank</button></form><form method="post" action="/admin/management/ranks/<%= r.id %>/delete"><button class="nav-link-button" type="submit">Delete Rank</button></form><% }) %><form method="post" action="/admin/management/departments/<%= d.id %>/ranks"><input name="name" placeholder="New rank" required><input type="number" name="sort_order" placeholder="Order"><input name="discord_role_id" placeholder="Discord role ID"><label><input type="checkbox" name="is_command"> Command rank</label><button class="btn secondary">Add Rank</button></form></div><% }) %></article><article class="panel admin-section"><h2>Create Department</h2><form method="post" action="/admin/management/departments"><input name="name" placeholder="Department name" required><input name="slug" placeholder="URL slug (optional)"><textarea name="description" placeholder="Description"></textarea><input name="discord_role_id" placeholder="Main Discord role ID"><input name="recruit_discord_role_id" placeholder="Recruit Discord role ID"><input name="member_discord_role_id" placeholder="Member Discord role ID"><button class="btn">Create Department</button></form></article><article class="panel admin-section"><h2>Certifications</h2><% certs.forEach(c=>{ %><div class="admin-row"><div><strong><%= c.name %></strong><div class="muted"><%= c.department_name||'Community-wide' %></div></div></div><% }) %><form method="post" action="/admin/management/certifications"><input name="name" placeholder="Certification name" required><input type="number" name="department_id" placeholder="Department ID (optional)"><input type="number" name="expires_after_days" placeholder="Expires after days"><textarea name="description" placeholder="Description"></textarea><button class="btn">Create Certification</button></form></article></section><aside><section class="panel"><h2>Pending LOA</h2><% if(!loa.length){ %><p class="muted">No pending LOA requests.</p><% } %><% loa.forEach(l=>{ %><div class="review-answer"><strong><%= l.display_name||l.discord_username %></strong><p><%= new Date(l.start_date).toLocaleDateString() %> – <%= new Date(l.end_date).toLocaleDateString() %></p><p><%= l.reason %></p><form method="post" action="/admin/management/loa/<%= l.id %>"><textarea name="review_note" placeholder="Review note"></textarea><button class="btn" name="status" value="approved">Approve</button><button class="btn secondary" name="status" value="denied">Deny</button></form></div><% }) %></section><section class="panel admin-section"><h2>Recent Audit Activity</h2><% audit.forEach(a=>{ %><div class="staff-note"><strong><%= a.action %></strong><p><%= a.display_name||'System' %> · <%= a.entity_type||'' %> <%= a.entity_id||'' %></p><small><%= new Date(a.created_at).toLocaleString() %></small></div><% }) %></section></aside></div><%- include('../partials/footer') %>
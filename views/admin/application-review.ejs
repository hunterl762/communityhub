<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">APPLICATION REVIEW</div><h1>#<%= application.id %> · <%= application.form_title %></h1><p><%= application.display_name||application.discord_username||'Unknown applicant' %> · Discord ID: <%= application.discord_id||'Unavailable' %></p></div><a class="btn secondary" href="/admin">Back to Dashboard</a></section><div class="split"><section class="panel"><span class="pill"><%= application.status.replaceAll('_',' ') %></span><h2>Applicant Answers</h2><% answers.forEach(a=>{ %><div class="review-answer"><strong><%= a.label %></strong><p><%= a.answer_text||'—' %></p></div><% }) %></section><aside class="panel"><h2>Review Decision</h2><form method="post" action="/admin/applications/<%= application.id %>/status"><label><span>Status</span><select name="status" required><option value="under_review">Under Review</option><option value="changes_requested">Changes Requested</option><option value="interview">Interview</option><option value="accepted">Accepted</option><option value="denied">Denied</option><option value="archived">Archived</option></select></label><label><span>Review note / reason</span><textarea name="reason"></textarea></label><button class="btn" type="submit">Update Application</button></form><h2>History</h2><div class="timeline compact"><% history.forEach(h=>{ %><div><strong><%= h.status.replaceAll('_',' ') %></strong><div class="muted"><%= h.note||'' %></div><small><%= h.changed_by_name||'System' %> · <%= new Date(h.created_at).toLocaleString() %></small></div><% }) %></div></aside></div><%- include('../partials/footer') %>
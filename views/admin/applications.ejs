<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">COMMUNITY ADMINISTRATION</div><h1>Application Reviews</h1><p>Latest 50 records. Open a record to review it.</p></div></section><div data-live-url="/admin/live"><p class="muted" data-live-notice role="status">Updates every 15 seconds</p><section class="panel"><div class="admin-list" data-review-apps><% if(!applications.length){ %><p class="muted">No applications have been submitted.</p><% } %><% applications.forEach(a=>{ %><a class="admin-row" href="/admin/applications/<%= a.id %>"><div><strong>#<%= a.id %> · <%= a.form_title %></strong><div class="muted"><%= a.display_name||a.discord_username||'Unknown applicant' %> · <%= a.submitted_at ? new Date(a.submitted_at).toLocaleString() : '' %></div></div><span class="pill"><%= a.status.replaceAll('_',' ') %></span></a><% }) %></div></section></div><script src="/js/live.js" defer></script><%- include('../partials/footer') %>
<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow"><%= communityName %></div><h1>Website content</h1><p>Edit the public pages and how shared links introduce your community.</p></div><div class="actions"><a class="btn secondary" href="/home" target="_blank" rel="noopener">View landing page ↗</a><a class="btn secondary" href="/about" target="_blank" rel="noopener">View About ↗</a><a class="btn secondary" href="/gallery" target="_blank" rel="noopener">View Gallery ↗</a></div></section><form class="content-editor" method="post" action="/admin/website"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="panel"><h2>Shared link preview</h2><p>The community name and current <a href="/admin/appearance">logo</a> are included automatically.</p><label><span>Public website address</span><input name="public_url" type="url" maxlength="500" placeholder="https://your-community.example" value="<%= content.public_url %>"></label><p class="muted">Use the address visitors can reach. A localhost address cannot be reached by Discord.</p><label><span>Website description · up to 500 characters</span><textarea name="description" maxlength="500" rows="3"><%= content.description %></textarea></label><div class="link-preview"><strong><%= communityName %></strong><p><%= content.description %></p><% if(communityLogo){ %><img src="<%= communityLogo %>" alt="Community logo"><% } %></div></section><section class="panel"><h2>Landing page</h2><label><span>Hero backdrop</span><select name="hero_image"><option value="/images/community-city-v3.png" <%= content.hero_image==='/images/community-city-v3.png'?'selected':'' %>>City at dusk</option><option value="" <%= !content.hero_image?'selected':'' %>>No backdrop</option><% images.filter(i=>i.is_published&&!i.is_removed).forEach(i=>{const url='/gallery/image/'+i.id; %><option value="<%= url %>" <%= content.hero_image===url?'selected':'' %>><%= i.title %></option><% }) %></select></label><p class="muted">Publish a gallery image to use it here. Hidden or removed images fall back to the city backdrop.</p><% [['hero_title','Main heading',160],['side_title','Highlights heading',160],['section_title','Community section heading',160],['cta_title','Closing heading',160],['cta_label','Closing button label',80],['cta_url','Closing button link',500]].forEach(([key,label,max])=>{ %><label><span><%= label %></span><input name="<%= key %>" maxlength="<%= max %>" value="<%= content[key] %>" required></label><% }) %><% [['hero_body','Introduction',2000],['highlights','Highlights · one per line, up to three',600],['section_body','Community section text',5000],['cta_body','Closing text',2000]].forEach(([key,label,max])=>{ %><label><span><%= label %></span><textarea name="<%= key %>" maxlength="<%= max %>" rows="3"><%= content[key] %></textarea></label><% }) %><% [['show_stats','Show activity totals'],['show_resources','Show resource links'],['show_section','Show community section'],['show_cta','Show closing invitation']].forEach(([key,label])=>{ %><label class="checkbox-label"><input type="checkbox" name="<%= key %>" <%= content[key]?'checked':'' %>><span><%= label %></span></label><% }) %></section><section class="panel"><h2>About & gallery pages</h2><% [['about_title','About heading',160],['gallery_title','Gallery heading',160]].forEach(([key,label,max])=>{ %><label><span><%= label %></span><input name="<%= key %>" maxlength="<%= max %>" value="<%= content[key] %>" required></label><% }) %><label><span>About text · paragraphs supported</span><textarea name="about_body" maxlength="12000" rows="8"><%= content.about_body %></textarea></label><label><span>Gallery introduction</span><textarea name="gallery_body" maxlength="2000" rows="3"><%= content.gallery_body %></textarea></label><p class="muted">About, Gallery and published images are visible without signing in.</p></section><button class="btn">Save website content</button></form><section class="panel" id="gallery-editor"><h2>Gallery images</h2><form method="post" action="/admin/website/gallery" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><span>Image · PNG, JPEG or WebP · up to 4 MB</span><input type="file" name="image" accept="image/png,image/jpeg,image/webp" required></label><label><span>Image title</span><input name="title" maxlength="160" required></label><label><span>Caption</span><textarea name="caption" maxlength="2000" rows="2"></textarea></label><label><span>Display order · lower numbers appear first</span><input type="number" name="sort_order" value="0" min="-100000" max="100000"></label><label class="checkbox-label"><input type="checkbox" name="is_published" checked><span>Publish image</span></label><button class="btn">Add image</button></form><p class="muted">Only published images are public. Removing an image hides it and retains it for restoration.</p><% images.forEach(image=>{ %><article class="gallery-editor-item"><img class="gallery-editor-preview" src="/admin/website/gallery/<%= image.id %>/image" alt="<%= image.title %>"><h3><%= image.title %> <span class="pill"><%= image.is_removed?'Removed':image.is_published?'Published':'Draft' %></span></h3><form method="post" action="/admin/website/gallery/<%= image.id %>/save"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><span>Title</span><input name="title" maxlength="160" value="<%= image.title %>" required></label><label><span>Caption</span><textarea name="caption" maxlength="2000"><%= image.caption %></textarea></label><label><span>Display order</span><input type="number" name="sort_order" value="<%= image.sort_order %>" min="-100000" max="100000"></label><label class="checkbox-label"><input type="checkbox" name="is_published" <%= image.is_published?'checked':'' %>><span>Publish image</span></label><button class="btn secondary">Save image details</button></form><form class="compact-action" method="post" action="/admin/website/gallery/<%= image.id %>/<%= image.is_removed?'restore':'remove' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary"><%= image.is_removed?'Restore image':'Remove image' %></button></form></article><% }) %></section><%- include('../partials/footer') %>

<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">USER MANAGEMENT</div><h1>Members & Roles</h1><p>Search Discord-linked Community Hub users and assign access roles.</p></div><a class="btn secondary" href="/admin">Admin Dashboard</a></section><section class="panel"><form method="get" action="/admin/users"><label><span>Search by Discord username, display name, Discord ID or email</span><input name="q" value="<%= q %>" placeholder="Search users..." autofocus></label><button class="btn">Search</button></form></section><div class="admin-list panel"><% if(q&&!users.length){ %><p class="muted">No matching users found.</p><% } %><% users.forEach(u=>{ %><div class="admin-row"><div><strong><%= u.display_name||u.discord_username %></strong><div class="muted"><%= u.discord_username||'' %> · Discord ID: <%= u.discord_id||'N/A' %></div><small>Current role: <%= u.role.replaceAll('_',' ') %></small></div><form method="post" action="/admin/users/<%= u.id %>/role"><input type="hidden" name="return_q" value="<%= q %>"><select name="role"><% roles.forEach(r=>{ %><option value="<%= r %>" <%= r===u.role?'selected':'' %>><%= r.replaceAll('_',' ') %></option><% }) %></select><button class="btn" type="submit">Assign Role</button></form></div><% }) %></div><%- include('../partials/footer') %>
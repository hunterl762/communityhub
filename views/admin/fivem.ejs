<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="panel"><h2>Tablet features & community branding</h2><p>Control in-game applications and the duty HUD. Upload a community logo shared with the website.</p><a class="btn" href="/admin/appearance">Manage tablet features & logo</a></section>
<section class="page-head"><div><div class="eyebrow">SERVER OPERATIONS</div><h1>FiveM Configuration</h1><p>Manage server settings, API credentials and announcements for your in-game tablet.</p></div><a class="btn secondary" href="/fivem">View live operations</a></section>
<nav class="section-links" aria-label="FiveM sections"><a href="#servers">Server configuration</a><a href="#api-keys">API keys</a><a href="#setup">Resource setup</a><a href="#announcements">Announcements</a></nav>
<section class="live-summary" data-live-url="/admin/fivem/live"><div class="live-caption"><span class="live-dot"></span><span data-live-notice role="status">Server availability and patrol totals update every 15 seconds</span><a href="/fivem/status">View status history →</a></div><div data-server-cards class="grid two compact-status"></div><div class="stats"><div><b><%= servers.length %></b><span>Configured servers</span></div><div><b data-live-stat="patrols"><%= stats.patrols %></b><span>Patrols · 30 days</span></div><div><b data-live-stat="patrol_hours"><%= Math.round(stats.patrol_minutes/60) %>h</b><span>Patrol hours · 30 days</span></div><div><b data-live-stat="unique_members"><%= stats.unique_members %></b><span>Active members · 30 days</span></div></div></section>
<% if(newApiKey){ %><section class="panel api-secret" role="status"><h2>New API key — shown once</h2><pre><%= newApiKey %></pre><p>Copy this into Config.ApiKey in your server-side config.lua now. Only its hash is stored; the key cannot be retrieved later.</p></section><% } %>
<div class="split fivem-admin"><section id="servers"><h2>Server configuration</h2><% if(!servers.length){ %><div class="panel"><p>No servers are configured. Import migrations 005 and 006 to create the primary server, then return here.</p></div><% } %>
<% servers.forEach(s=>{ const live=s.last_heartbeat_at && Date.now()-new Date(s.last_heartbeat_at).getTime()<90000; %>
<article class="panel server-card"><div class="server-title"><h3><%= s.name %></h3><span class="pill"><%= !s.is_enabled?'Disabled':live?'Heartbeat active':'No recent heartbeat' %></span></div>
<dl class="server-meta"><div><dt>Server key</dt><dd><code><%= s.server_key %></code></dd></div><div><dt>Players reported</dt><dd><%= s.current_players||0 %> / <%= s.max_players %></dd></div><div><dt>Last heartbeat</dt><dd><%= s.last_heartbeat_at?new Date(s.last_heartbeat_at).toLocaleString():'Never received' %></dd></div></dl>
<form method="post" action="/admin/fivem/servers/<%= s.id %>" class="server-form"><div class="form-grid">
<label><span>Display name</span><input name="name" value="<%= s.name %>" maxlength="120" required></label>
<label><span>Framework</span><select name="framework"><option value="standalone" <%= s.framework==='standalone'?'selected':'' %>>Standalone / vMenu</option><option value="qbcore" <%= s.framework==='qbcore'?'selected':'' %>>QBCore</option></select></label>
<label><span>Hostname</span><input name="hostname" value="<%= s.hostname||'' %>" maxlength="255"></label>
<label><span>Maximum players</span><input type="number" name="max_players" min="1" step="1" value="<%= s.max_players %>" required></label>
<label><span>FiveM connect URL</span><input name="connect_url" value="<%= s.connect_url||'' %>" maxlength="255" placeholder="fivem://connect/your-server"></label>
<label><span>Restart schedule</span><input name="restart_schedule" value="<%= s.restart_schedule||'' %>" maxlength="255" placeholder="e.g. Daily at 6 AM Eastern"></label>
</div><label class="checkbox-label"><input type="checkbox" name="is_enabled" <%= s.is_enabled?'checked':'' %>> Server enabled (configuration flag)</label><p class="muted">Hostname and maximum players are refreshed by server heartbeats. Match the framework in config.lua; saving here does not edit the FiveM resource or schedule server restarts. The enabled flag records configuration status; revoke API credentials or stop the resource to disconnect it.</p><button class="btn" type="submit">Save server configuration</button></form></article><% }) %>
<section class="panel admin-section" id="announcements"><h2>tablet announcements</h2><form method="post" action="/admin/fivem/announcements"><label><span>Title</span><input name="title" required></label><label><span>Message</span><textarea name="message" required></textarea></label><div class="form-grid"><label><span>Priority</span><select name="priority"><option value="info">Information</option><option value="important">Important</option><option value="critical">Critical</option></select></label><label><span>Expires at (optional)</span><input type="datetime-local" name="expires_at"></label></div><button class="btn">Publish to tablet</button></form><h3>Recent announcements</h3><% if(!announcements.length){ %><p class="muted">No announcements published yet.</p><% } %><% announcements.forEach(a=>{ %><div class="staff-note"><strong><%= a.title %></strong><p class="preserve-lines"><%= a.message %></p><small><%= a.priority %> · <%= !a.is_active?'Inactive':a.expires_at&&new Date(a.expires_at)<new Date()?'Expired':'Active' %></small></div><% }) %></section></section>
<aside><section class="panel" id="api-keys"><h2>API key generator</h2><p class="muted">Create a separate credential for each server. Generated keys are shown once.</p><form method="post" action="/admin/fivem/api-keys"><label><span>Key name</span><input name="name" placeholder="Primary server" required></label><label><span>Server</span><select name="server_id"><option value="">Any server</option><% servers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label><button class="btn">Generate API key</button></form><h3>Credentials</h3><% if(!keys.length){ %><p class="muted">No generated keys yet.</p><% } %><div class="admin-list"><% keys.forEach(k=>{ %><div class="credential"><strong><%= k.name %></strong><div class="muted"><code><%= k.key_prefix %>…</code> · <%= k.server_name||'Any server' %></div><small>Created: <%= new Date(k.created_at).toLocaleString() %><br>Last used: <%= k.last_used_at?new Date(k.last_used_at).toLocaleString():'Never' %></small><% if(k.is_active){ %><form method="post" action="/admin/fivem/api-keys/<%= k.id %>/revoke"><button class="btn secondary" aria-label="Revoke <%= k.name %>">Revoke key</button></form><% }else{ %><span class="pill">Revoked</span><% } %></div><% }) %></div></section>
<section class="panel admin-section" id="setup"><h2>Resource setup</h2><ol><li>Save the server settings and generate a key above.</li><li>Open <code>fivem/communityhub/config.lua</code> on your FiveM server.</li><li>Set <code>Config.ApiBase</code> to your reachable website URL ending in <code>/api/fivem</code>.</li><li>Set <code>Config.ApiKey</code> to the generated key, and <code>Config.ServerKey</code> to the server key shown here.</li><li>Match <code>Config.Framework</code> to <code>'standalone'</code> or <code>'qbcore'</code>; also set <code>Config.ServerName</code> and <code>Config.MaxPlayers</code>.</li><li>For QBCore, start <code>qb-core</code> first. Add <code>ensure communityhub</code> to server.cfg and restart the resource.</li></ol><p class="muted">Keep API keys in server-side configuration. Never put them in client or NUI files.</p></section></aside></div><script src="/js/live.js" defer></script><%- include('../partials/footer') %>

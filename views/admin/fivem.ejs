<%- include('../partials/header') %><section class="page-head cad-head"><div><div class="eyebrow">FIVEM COMMAND</div><h1>Server Operations</h1><p>Configure FiveM/QBCore servers, API credentials, announcements and patrol analytics.</p></div></section><div class="stats"><div><b><%= stats.patrols %></b><span>Patrols · 30 days</span></div><div><b><%= Math.round(stats.patrol_minutes/60) %>h</b><span>Patrol hours</span></div><div><b><%= stats.unique_members %></b><span>Active members</span></div></div><% if(newApiKey){ %><section class="panel api-secret"><div class="eyebrow">NEW API KEY — SHOWN ONCE</div><pre><%= newApiKey %></pre><p>Copy this into the FiveM server configuration now. Community Hub stores only its hash.</p></section><% } %><div class="split"><section><article class="panel"><h2>FiveM Servers</h2><% servers.forEach(s=>{ %><form class="review-answer" method="post" action="/admin/fivem/servers/<%= s.id %>"><input name="name" value="<%= s.name %>" required><input name="hostname" value="<%= s.hostname||'' %>" placeholder="Hostname"><input type="number" name="max_players" value="<%= s.max_players %>"><select name="framework"><option value="standalone" <%= s.framework==='standalone'?'selected':'' %>>Standalone / vMenu</option><option value="qbcore" <%= s.framework==='qbcore'?'selected':'' %>>QBCore</option></select><input name="connect_url" value="<%= s.connect_url||'' %>" placeholder="FiveM connect URL"><input name="restart_schedule" value="<%= s.restart_schedule||'' %>" placeholder="Restart schedule"><label><input type="checkbox" name="is_enabled" <%= s.is_enabled?'checked':'' %>> Enabled</label><button class="btn">Save Server</button></form><% }) %></article><article class="panel admin-section"><h2>Announcements</h2><form method="post" action="/admin/fivem/announcements"><input name="title" placeholder="Announcement title" required><textarea name="message" placeholder="Message" required></textarea><select name="priority"><option value="info">Information</option><option value="important">Important</option><option value="critical">Critical</option></select><input type="datetime-local" name="expires_at"><button class="btn">Publish to MDT</button></form><% announcements.forEach(a=>{ %><div class="staff-note"><strong><%= a.title %></strong><p><%= a.message %></p><small><%= a.priority %></small></div><% }) %></article></section><aside><section class="panel"><h2>API Key Generator</h2><p class="muted">Generate a separate server credential instead of putting the global website secret into resources.</p><form method="post" action="/admin/fivem/api-keys"><input name="name" placeholder="Key name" required><select name="server_id"><option value="">Any server</option><% servers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select><button class="btn">Generate API Key</button></form><div class="admin-list"><% keys.forEach(k=>{ %><div class="admin-row"><div><strong><%= k.name %></strong><div class="muted"><%= k.key_prefix %>… · <%= k.server_name||'Any server' %></div></div><% if(k.is_active){ %><form method="post" action="/admin/fivem/api-keys/<%= k.id %>/revoke"><button class="nav-link-button">Revoke</button></form><% }else{ %><span class="pill">revoked</span><% } %></div><% }) %></div></section></aside></div><%- include('../partials/footer') %>
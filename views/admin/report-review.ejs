<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">REPORT REVIEW</div><h1>#<%= report.id %> · <%= report.report_type %></h1><p>Submitted by <%= report.reporter_name||report.reporter_discord||'Unknown user' %> · <%= new Date(report.created_at).toLocaleString() %></p></div><a class="btn secondary" href="/admin">Back to Dashboard</a></section><div class="split"><section class="panel"><div class="review-meta"><span class="pill"><%= report.status.replaceAll('_',' ') %></span><% if(report.assigned_name){ %><span class="muted">Assigned to <%= report.assigned_name %></span><% } %></div><h2>Report Details</h2><div class="review-answer"><strong>Reported Player / Subject</strong><p><%= report.reported_name||'Not provided' %></p></div><div class="review-answer"><strong>Incident Time</strong><p><%= report.occurred_at?new Date(report.occurred_at).toLocaleString():'Not provided' %></p></div><div class="review-answer"><strong>Description</strong><p><%= report.description %></p></div><% if(report.evidence_url){ %><div class="review-answer"><strong>Evidence</strong><p><a class="text-link" href="<%= report.evidence_url %>" target="_blank" rel="noopener noreferrer">Open submitted evidence</a></p></div><% } %><% if(report.resolution){ %><div class="review-answer"><strong>Current Resolution</strong><p><%= report.resolution %></p></div><% } %></section><aside><section class="panel"><h2>Report Status</h2><form method="post" action="/admin/reports/<%= report.id %>/status"><label><span>Status</span><select name="status" required><% ['open','under_review','actioned','dismissed','closed'].forEach(s=>{ %><option value="<%= s %>" <%= report.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><label><span>Resolution / Review Note</span><textarea name="resolution" placeholder="Document the action taken, dismissal reason, or final resolution..."><%= report.resolution||'' %></textarea></label><button class="btn" type="submit">Update Report</button></form></section><section class="panel admin-section"><h2>Internal Staff Notes</h2><div class="timeline compact"><% if(!comments.length){ %><p class="muted">No internal notes yet.</p><% } %><% comments.forEach(c=>{ %><div class="staff-note"><strong><%= c.author_name||c.author_discord||'Staff' %></strong><p><%= c.comment %></p><small><%= new Date(c.created_at).toLocaleString() %></small></div><% }) %></div><form method="post" action="/admin/reports/<%= report.id %>/comments"><label><span>Add internal note</span><textarea name="comment" required></textarea></label><button class="btn secondary" type="submit">Add Note</button></form></section></aside></div><%- include('../partials/footer') %>
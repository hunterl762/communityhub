<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">STAFF CONTROL CENTER</div><h1>Admin Dashboard</h1><p>Review applications and monitor Community Hub activity.</p></div></section><div class="stats"><div><b><%= appStats.pending||0 %></b><span>Pending applications</span></div><div><b><%= appStats.under_review||0 %></b><span>Under review</span></div><div><b><%= appStats.interviews||0 %></b><span>Interviews</span></div><div><b><%= reportStats.open_reports||0 %></b><span>Open reports</span></div></div><section class="panel"><h2>Application Reviews</h2><div class="admin-list"><% if(!applications.length){ %><p class="muted">No applications have been submitted.</p><% } %><% applications.forEach(a=>{ %><a class="admin-row" href="/admin/applications/<%= a.id %>"><div><strong>#<%= a.id %> · <%= a.form_title %></strong><div class="muted"><%= a.display_name||a.discord_username||'Unknown applicant' %> · <%= a.submitted_at ? new Date(a.submitted_at).toLocaleString() : '' %></div></div><span class="pill"><%= a.status.replaceAll('_',' ') %></span></a><% }) %></div></section><%- include('../partials/footer') %>
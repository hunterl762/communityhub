<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">COMMUNITY ADMINISTRATION</div><h1>Admin Center</h1><p>Review applications and reports, manage personnel, training and <%= communityName %>.</p></div></section><div data-live-url="/admin/live"><section class="live-summary"><div class="live-caption"><span class="live-dot"></span><span data-live-notice role="status">Review totals update every 15 seconds</span></div><div class="stats"><div><b data-live-stat="pending"><%= appStats.pending||0 %></b><span>Pending applications</span></div><div><b data-live-stat="applications_review"><%= appStats.under_review||0 %></b><span>Applications under review</span></div><div><b data-live-stat="open_reports"><%= reportStats.open_reports||0 %></b><span>Open reports</span></div><div><b data-live-stat="reports_review"><%= reportStats.under_review||0 %></b><span>Reports under review</span></div></div></section><section class="admin-tools" aria-labelledby="admin-tools-title"><h2 id="admin-tools-title">Management workspace</h2><div class="grid two"><% if(['staff','admin','management','owner'].includes(user.role)){ %><a class="card" href="/admin/tickets"><h3>Ticket Reviews</h3><p>Review support requests, reply to members and update ticket statuses.</p></a><% } %><a class="card" href="/admin/applications"><h3>Application Reviews</h3><p>Review submissions and record decisions.</p></a><a class="card" href="/admin/reports"><h3>Report Reviews</h3><p>Review community reports and staff notes.</p></a>
<% if(['admin','management','owner'].includes(user.role)){ %><a class="card" href="/admin/fivem"><div class="eyebrow">SERVER OPERATIONS</div><h3>FiveM configuration</h3><p>View server settings, choose QBCore or standalone, generate API keys and publish tablet announcements.</p><span class="tool-link">Manage FiveM →</span></a><a class="card" href="/admin/website"><h3>Website content</h3><p>Customize the landing page, About, Gallery and shared link previews.</p></a><a class="card" href="/admin/application-builder"><h3>Application builder</h3><p>Manage department applications and their questions.</p></a><% } %>
<% if(['department_command','staff','admin','management','owner'].includes(user.role)){ %><a class="card" href="/admin/management"><h3>Community management</h3><p>Manage departments, ranks, certifications, leave requests and audit activity.</p></a><% } %>
<% if(canManageUsers){ %><a class="card" href="/admin/users"><h3>Members & roles</h3><p>Find members and manage their access.</p></a><% } %>
<a class="card" href="/training"><h3>Training</h3><p>View scheduled training and session rosters.</p></a><a class="card" href="/personnel"><h3>Personnel roster</h3><p>Browse department members and profiles.</p></a>
</div></section></div><script src="/js/live.js" defer></script><%- include('../partials/footer') %>

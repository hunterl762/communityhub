<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">COMMUNITY ADMINISTRATION</div><h1>Admin Center</h1><p>Review applications and reports, manage personnel, training and <%= communityName %>.</p></div></section><div data-live-url="/admin/live"><section class="live-summary"><div class="live-caption"><span class="live-dot"></span><span data-live-notice role="status">Review totals update every 15 seconds</span></div><div class="stats"><div><b data-live-stat="pending"><%= appStats.pending||0 %></b><span>Pending applications</span></div><div><b data-live-stat="applications_review"><%= appStats.under_review||0 %></b><span>Applications under review</span></div><div><b data-live-stat="open_reports"><%= reportStats.open_reports||0 %></b><span>Open reports</span></div><div><b data-live-stat="reports_review"><%= reportStats.under_review||0 %></b><span>Reports under review</span></div></div></section><section class="admin-tools" aria-labelledby="admin-tools-title"><h2 id="admin-tools-title">Management workspace</h2><div class="grid two">
<% if(['admin','management','owner'].includes(user.role)){ %><a class="card" href="/admin/fivem"><div class="eyebrow">SERVER OPERATIONS</div><h3>FiveM configuration</h3><p>View server settings, choose QBCore or standalone, generate API keys and publish MDT announcements.</p><span class="tool-link">Manage FiveM →</span></a><a class="card" href="/admin/application-builder"><h3>Application builder</h3><p>Manage department applications and their questions.</p></a><% } %>
<% if(['department_command','staff','admin','management','owner'].includes(user.role)){ %><a class="card" href="/admin/management"><h3>Community management</h3><p>Manage departments, ranks, certifications, leave requests and audit activity.</p></a><% } %>
<% if(canManageUsers){ %><a class="card" href="/admin/users"><h3>Members & roles</h3><p>Find members and manage their access.</p></a><% } %>
<a class="card" href="/training"><h3>Training</h3><p>View scheduled training and session rosters.</p></a><a class="card" href="/personnel"><h3>Personnel roster</h3><p>Browse department members and profiles.</p></a>
</div></section><div class="admin-review-grid"><section class="panel"><h2>Application Reviews</h2><div class="admin-list" data-review-apps><% if(!applications.length){ %><p class="muted">No applications have been submitted.</p><% } %><% applications.forEach(a=>{ %><a class="admin-row" href="/admin/applications/<%= a.id %>"><div><strong>#<%= a.id %> · <%= a.form_title %></strong><div class="muted"><%= a.display_name||a.discord_username||'Unknown applicant' %> · <%= a.submitted_at ? new Date(a.submitted_at).toLocaleString() : '' %></div></div><span class="pill"><%= a.status.replaceAll('_',' ') %></span></a><% }) %></div></section><section class="panel admin-section"><h2>Report Reviews</h2><p class="muted">Review FailRP, VDM, RDM, staff and other community reports.</p><div class="admin-list" data-review-reports><% if(!reports.length){ %><p class="muted">No reports have been submitted.</p><% } %><% reports.forEach(r=>{ %><a class="admin-row" href="/admin/reports/<%= r.id %>"><div><strong>#<%= r.id %> · <%= r.report_type %><%= r.reported_name?' · '+r.reported_name:'' %></strong><div class="muted">Reported by <%= r.reporter_name||r.reporter_discord||'Unknown user' %> · <%= r.created_at ? new Date(r.created_at).toLocaleString() : '' %></div></div><span class="pill"><%= r.status.replaceAll('_',' ') %></span></a><% }) %></div></section></div><% if(isOwner){ %><section class="panel admin-setting" id="community-settings"><h2>Community Settings</h2><form method="post" action="/admin/settings/community-name"><label><span>Community name</span><input name="community_name" maxlength="120" value="<%= communityName %>" required></label><button class="btn">Save Community Name</button></form></section><% } %><%- include('../partials/patrol-log',{clockLog:typeof clockLog==='undefined'?{sessions:[],events:[]}:clockLog}) %></div><script src="/js/live.js" defer></script><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">STAFF CONTROL CENTER</div><h1>Admin Dashboard</h1><p>Review applications and reports, manage personnel, training and <%= communityName %>.</p></div><div class="actions"><a class="btn secondary" href="/admin/management">Community Management</a><% if(canManageUsers){ %><a class="btn secondary" href="/admin/users">Members & Roles</a><% } %><a class="btn secondary" href="/training">Training Rosters</a><a class="btn secondary" href="/personnel">Personnel Roster</a></div></section><div class="stats"><div><b><%= appStats.pending||0 %></b><span>Pending applications</span></div><div><b><%= appStats.under_review||0 %></b><span>Applications under review</span></div><div><b><%= reportStats.open_reports||0 %></b><span>Open reports</span></div><div><b><%= reportStats.under_review||0 %></b><span>Reports under review</span></div></div><% if(isOwner){ %><section class="panel admin-setting"><h2>Community Settings</h2><form method="post" action="/admin/settings/community-name"><label><span>Community name</span><input name="community_name" maxlength="120" value="<%= communityName %>" required></label><button class="btn">Save Community Name</button></form></section><% } %><section class="panel"><h2>Application Reviews</h2><div class="admin-list"><% if(!applications.length){ %><p class="muted">No applications have been submitted.</p><% } %><% applications.forEach(a=>{ %><a class="admin-row" href="/admin/applications/<%= a.id %>"><div><strong>#<%= a.id %> · <%= a.form_title %></strong><div class="muted"><%= a.display_name||a.discord_username||'Unknown applicant' %> · <%= a.submitted_at ? new Date(a.submitted_at).toLocaleString() : '' %></div></div><span class="pill"><%= a.status.replaceAll('_',' ') %></span></a><% }) %></div></section><section class="panel admin-section"><h2>Report Reviews</h2><p class="muted">Review FailRP, VDM, RDM, staff and other community reports.</p><div class="admin-list"><% if(!reports.length){ %><p class="muted">No reports have been submitted.</p><% } %><% reports.forEach(r=>{ %><a class="admin-row" href="/admin/reports/<%= r.id %>"><div><strong>#<%= r.id %> · <%= r.report_type %><%= r.reported_name?' · '+r.reported_name:'' %></strong><div class="muted">Reported by <%= r.reporter_name||r.reporter_discord||'Unknown user' %> · <%= r.created_at ? new Date(r.created_at).toLocaleString() : '' %></div></div><span class="pill"><%= r.status.replaceAll('_',' ') %></span></a><% }) %></div></section><%- include('../partials/footer') %>
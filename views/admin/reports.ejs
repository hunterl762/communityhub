<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">COMMUNITY ADMINISTRATION</div><h1>Report Reviews</h1><p>Latest 50 records. Open a record to review it.</p></div></section><div data-live-url="/admin/live"><p class="muted" data-live-notice role="status">Updates every 15 seconds</p><section class="panel admin-section"><p class="muted">Review FailRP, VDM, RDM, staff and other community reports.</p><div class="admin-list" data-review-reports><% if(!reports.length){ %><p class="muted">No reports have been submitted.</p><% } %><% reports.forEach(r=>{ %><a class="admin-row" href="/admin/reports/<%= r.id %>"><div><strong>#<%= r.id %> · <%= r.report_type %><%= r.reported_name?' · '+r.reported_name:'' %></strong><div class="muted">Reported by <%= r.reporter_name||r.reporter_discord||'Unknown user' %> · <%= r.created_at ? new Date(r.created_at).toLocaleString() : '' %></div></div><span class="pill"><%= r.status.replaceAll('_',' ') %></span></a><% }) %></div></section></div><script src="/js/live.js" defer></script><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">APPLICATION BUILDER</div><h1><%= form.title %></h1><p>Edit form settings and questions.</p></div><a class="btn secondary" href="/applications/<%= form.slug %>">Preview Form</a></section><div class="split"><section><article class="panel"><h2>Questions</h2><% if(!questions.length){ %><p class="muted">No questions yet.</p><% } %><% questions.forEach(q=>{ %><div class="review-answer"><strong><%= q.label %></strong><p><%= q.question_type %> · <%= q.is_required?'Required':'Optional' %> · Order <%= q.sort_order %></p><form method="post" action="/admin/application-builder/questions/<%= q.id %>/delete"><button class="btn secondary">Delete</button></form></div><% }) %></article><article class="panel admin-section"><h2>Add Question</h2><form method="post" action="/admin/application-builder/forms/<%= form.id %>/questions"><label><span>Question</span><input name="label" required></label><label><span>Type</span><select name="question_type"><option value="text">Short text</option><option value="textarea">Long text</option><option value="select">Dropdown</option><option value="radio">Single choice</option><option value="checkbox">Checkboxes</option><option value="number">Number</option><option value="date">Date</option></select></label><label><span>Options — one per line</span><textarea name="options"></textarea></label><label><span>Sort order</span><input type="number" name="sort_order" value="0"></label><label><input type="checkbox" name="is_required"> Required</label><button class="btn">Add Question</button></form></article></section><aside class="panel"><h2>Form Settings</h2><form method="post" action="/admin/application-builder/forms/<%= form.id %>"><label><span>Title</span><input name="title" value="<%= form.title %>" required></label><label><span>Description</span><textarea name="description"><%= form.description||'' %></textarea></label><label><span>Sort order</span><input type="number" name="sort_order" value="<%= form.sort_order %>"></label><label><input type="checkbox" name="is_open" <%= form.is_open?'checked':'' %>> Accepting applications</label><button class="btn">Save Form</button></form></aside></div><%- include('../partials/footer') %>
<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">COMMUNITY ADMINISTRATION</div><h1>Ticket Reviews</h1><p>Review community support conversations and reply to members.</p></div></section><section class="panel"><form method="get" action="/admin/tickets" class="actions"><label><span>Ticket status</span><select name="status"><option value="">All statuses</option><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><button class="btn secondary">Filter tickets</button></form><div class="admin-list"><% if(!tickets.length){ %><p class="muted">No tickets match this status.</p><% } %><% tickets.forEach(t=>{ %><a class="admin-row" href="/support/tickets/<%= t.id %>"><div><strong>#<%= t.id %> · <%= t.subject %></strong><p class="muted"><%= t.display_name||'Member' %> · <%= t.category %> · <%= new Date(t.updated_at).toLocaleString() %></p></div><span class="pill"><%= t.status.replaceAll('_',' ') %></span></a><% }) %></div></section><%- include('../partials/footer') %>
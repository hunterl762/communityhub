<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">COMMUNITY ADMINISTRATION</div><h1>Ticket Reviews</h1><p>Review community support conversations and reply to members.</p></div></section><section class="panel"><form method="get" action="/admin/tickets" class="ticket-filters"><label><span>Ticket status</span><select name="status"><option value="">All statuses</option><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><label><span>Priority</span><select name="priority"><option value="">All priorities</option><% priorities.forEach(p=>{ %><option value="<%= p %>" <%= priority===p?'selected':'' %>><%= p %></option><% }) %></select></label><label><span>Assigned to</span><select name="assigned"><option value="">Everyone</option><option value="mine" <%= assigned==='mine'?'selected':'' %>>My tickets</option><option value="unassigned" <%= assigned==='unassigned'?'selected':'' %>>Unassigned</option></select></label><button class="btn secondary">Filter tickets</button></form><div class="admin-list"><% if(!tickets.length){ %><p class="muted">No tickets match this status.</p><% } %><% tickets.forEach(t=>{ %><a class="admin-row" href="/support/tickets/<%= t.id %>"><div><strong>#<%= t.id %> · <%= t.subject %></strong><p class="muted"><%= t.display_name||'Member' %> · <%= t.category %> · <%= new Date(t.updated_at).toLocaleString() %></p></div><span class="muted"><%= t.assigned_name||'Unassigned' %> · <%= t.priority||'normal' %> priority</span><span class="pill"><%= t.status.replaceAll('_',' ') %></span></a><% }) %></div></section><%- include('../partials/footer') %>
<%- include('../partials/header') %><%- include('../partials/admin-nav') %><section class="page-head"><div><div class="eyebrow">ADMINISTRATION</div><h1>Application Form Builder</h1><p>Create and manage department and community applications without Google Forms.</p></div></section><div class="split"><section class="panel"><h2>Application Forms</h2><div class="admin-list"><% forms.forEach(f=>{ %><a class="admin-row" href="/admin/application-builder/forms/<%= f.id %>"><div><strong><%= f.title %></strong><div class="muted"><%= f.question_count %> questions · <%= f.slug %></div></div><span class="pill"><%= f.is_open?'open':'closed' %></span></a><% }) %></div></section><aside class="panel"><h2>Create Form</h2><form method="post" action="/admin/application-builder/forms"><label><span>Title</span><input name="title" required></label><label><span>Slug</span><input name="slug" placeholder="auto-generated if blank"></label><label><span>Description</span><textarea name="description"></textarea></label><label><span>Sort order</span><input type="number" name="sort_order" value="0"></label><label><input type="checkbox" name="is_open" checked> Accepting applications</label><button class="btn">Create Application</button></form></aside></div><%- include('../partials/footer') %>
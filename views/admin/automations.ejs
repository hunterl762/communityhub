<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">ADMINISTRATION / AUTOMATION</div><h1>CommunityHub Flow</h1><p>Build event-driven community workflows and review every execution.</p></div></section><div class="split"><section><article class="panel"><div class="panel-heading"><div><div class="eyebrow">WORKFLOWS</div><h2>Flows</h2></div></div><% if(!flows.length){ %><p class="muted">No flows created yet.</p><% } %><% flows.forEach(f=>{ %><div class="review-answer"><div class="panel-heading"><div><strong><%= f.name %></strong><p><%= f.description||'No description' %></p><small><%= f.trigger_type.replaceAll('_',' ') %> · <%= f.condition_count %> conditions · <%= f.action_count %> actions</small></div><form method="post" action="/admin/automations/<%= f.id %>/toggle"><button class="btn secondary"><%= f.is_enabled?'Disable':'Enable' %></button></form></div><details><summary>Configure flow</summary><form method="post" action="/admin/automations/<%= f.id %>/condition"><h3>Add condition</h3><div class="form-grid"><input name="field_name" placeholder="context field, e.g. status" required><select name="operator_name"><% ['equals','not_equals','contains','not_contains','in','not_in','is_empty','is_not_empty'].forEach(o=>{ %><option value="<%= o %>"><%= o.replaceAll('_',' ') %></option><% }) %></select></div><input name="comparison_value" placeholder="Comparison value"><input type="number" name="sort_order" min="0" value="0"><button class="btn secondary">Add condition</button></form><form method="post" action="/admin/automations/<%= f.id %>/action"><h3>Add action</h3><select name="action_type"><% ['create_notification','set_member_status','set_recruit_stage','write_staff_note','write_audit_log'].forEach(a=>{ %><option value="<%= a %>"><%= a.replaceAll('_',' ') %></option><% }) %></select><textarea name="action_config_json" placeholder='{"status":"active"}'>{}</textarea><input type="number" name="sort_order" min="0" value="0"><button class="btn secondary">Add action</button></form><form method="post" action="/admin/automations/<%= f.id %>/run"><h3>Manual test</h3><input type="number" name="subject_user_id" placeholder="Optional member user ID"><button class="btn">Run manual trigger</button></form></details></div><% }) %></article><article class="panel admin-section"><div class="panel-heading"><div><div class="eyebrow">EXECUTION LOG</div><h2>Recent runs</h2></div></div><% if(!runs.length){ %><p class="muted">No workflow runs yet.</p><% } %><% runs.forEach(r=>{ %><div class="review-answer"><strong><%= r.flow_name %></strong><p><span class="pill"><%= r.status %></span> · <%= r.trigger_type.replaceAll('_',' ') %></p><small><%= new Date(r.started_at).toLocaleString() %><%= r.error_message?' · '+r.error_message:'' %></small></div><% }) %></article></section><aside><section class="panel"><div class="eyebrow">NEW FLOW</div><h2>Create workflow</h2><form method="post" action="/admin/automations/create"><label><span>Name</span><input name="name" required placeholder="Recruit acceptance workflow"></label><label><span>Description</span><textarea name="description" placeholder="What should this flow automate?"></textarea></label><label><span>Trigger</span><select name="trigger_type"><% ['application_submitted','application_status_changed','training_registered','training_completed','member_status_changed','manual'].forEach(t=>{ %><option value="<%= t %>"><%= t.replaceAll('_',' ') %></option><% }) %></select></label><label><input type="checkbox" name="is_enabled" value="1" checked> Enabled</label><button class="btn">Create flow</button></form></section><section class="panel admin-section"><div class="eyebrow">ACTION CONFIG</div><h2>JSON examples</h2><p class="muted"><code>{"title":"Application update","message":"Your application changed."}</code></p><p class="muted"><code>{"status":"active"}</code></p><p class="muted"><code>{"stage":"training","notes":"Advanced by Flow"}</code></p><p class="muted"><code>{"note_type":"general","note_text":"Automated note"}</code></p></section></aside></div><%- include('../partials/footer') %>
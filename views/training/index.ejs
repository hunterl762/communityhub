<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">TRAINING ROSTER</div><h1>Training Registration</h1><p>Register for upcoming department training and view open roster seats.</p></div></section><div class="<%= canManage?'split':'' %>"><section class="timeline"><% if(!sessions.length){ %><div class="panel"><p class="muted">No upcoming training sessions are scheduled.</p></div><% } %><% sessions.forEach(t=>{ const studentsLeft=Math.max(0,t.student_seats-t.student_count);const instructorsLeft=Math.max(0,t.instructor_seats-t.instructor_count); %><article class="event"><time><%= new Date(t.start_at).toLocaleString() %></time><div><span class="pill"><%= t.department_name||'Community' %></span><h2><%= t.title %></h2><p><%= t.description||'' %></p><p><strong>Students:</strong> <%= t.student_count %>/<%= t.student_seats %> · <%= studentsLeft %> open &nbsp; <strong>Instructors:</strong> <%= t.instructor_count %>/<%= t.instructor_seats %> · <%= instructorsLeft %> open</p><small><%= t.location||'' %> · Registration <%= t.registration_open?'Open':'Closed' %></small><% if(t.my_registration){ %><p class="success-text">Registered as <%= t.my_registration %></p><form method="post" action="/training/<%= t.id %>/cancel"><button class="btn secondary">Cancel Registration</button></form><% }else if(t.registration_open){ %><div class="actions"><% if(studentsLeft>0){ %><form method="post" action="/training/<%= t.id %>/register"><input type="hidden" name="registration_type" value="student"><button class="btn">Register as Student</button></form><% } %><% if(['department_command','staff','admin','management','owner'].includes(user.role)&&instructorsLeft>0){ %><form method="post" action="/training/<%= t.id %>/register"><input type="hidden" name="registration_type" value="instructor"><button class="btn secondary">Register as Instructor</button></form><% } %></div><% } %><% if(canManage){ %><form method="post" action="/training/admin/<%= t.id %>/toggle"><button class="nav-link-button" type="submit"><%= t.registration_open?'Close':'Open' %> Registration</button></form><% } %></div></article><% }) %></section><% if(canManage){ %><aside class="panel"><h2>Create Training</h2><p class="muted">Department Command, Admin, Management and Owner can configure rosters.</p><form method="post" action="/training/admin/create"><label><span>Training name</span><input name="title" required></label><label><span>Starts</span><input type="datetime-local" name="start_at" required></label><label><span>Ends</span><input type="datetime-local" name="end_at"></label><label><span>Location</span><input name="location"></label><label><span>Instructor seats</span><input type="number" min="1" name="instructor_seats" value="2" required></label><label><span>Student seats</span><input type="number" min="1" name="student_seats" value="10" required></label><label><span>Description</span><textarea name="description"></textarea></label><button class="btn">Create Training</button></form></aside><% } %></div><%- include('../partials/footer') %>
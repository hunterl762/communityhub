<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">TRAINING</div><h1>Training Center</h1><p>Upcoming sessions, rosters, attendance and qualification history.</p></div></section><div class="<%= canManage?'split':'' %>"><section class="timeline"><% if(!sessions.length){ %><div class="panel"><p class="muted">No training sessions are available.</p></div><% } %><% sessions.forEach(t=>{ const studentsLeft=Math.max(0,t.student_seats-t.student_count);const instructorsLeft=Math.max(0,t.instructor_seats-t.instructor_count); %><article class="event"><time><%= new Date(t.start_at).toLocaleString() %></time><div><span class="pill"><%= t.department_name||'Community' %></span><h2><%= t.title %></h2><p><%= t.description||'' %></p><p><strong>Students:</strong> <%= t.student_count %>/<%= t.student_seats %> · <%= studentsLeft %> open &nbsp; <strong>Instructors:</strong> <%= t.instructor_count %>/<%= t.instructor_seats %> · <%= instructorsLeft %> open</p><small><%= t.location||'Location TBA' %> · Registration <%= t.registration_open?'Open':'Closed' %></small><% if(t.my_registration){ %><p class="success-text">Registered as <%= t.my_registration %></p><form method="post" action="/training/<%= t.id %>/cancel"><button class="btn secondary">Cancel registration</button></form><% }else if(t.registration_open&&new Date(t.start_at)>new Date()){ %><div class="actions"><% if(studentsLeft>0){ %><form method="post" action="/training/<%= t.id %>/register"><input type="hidden" name="registration_type" value="student"><button class="btn">Register as student</button></form><% } %><% if(['department_command','staff','admin','management','owner'].includes(user.role)&&instructorsLeft>0){ %><form method="post" action="/training/<%= t.id %>/register"><input type="hidden" name="registration_type" value="instructor"><button class="btn secondary">Register as instructor</button></form><% } %></div><% } %><% if(canManage){ %><div class="admin-section"><form method="post" action="/training/admin/<%= t.id %>/toggle"><button class="nav-link-button" type="submit"><%= t.registration_open?'Close':'Open' %> registration</button></form><details><summary>Manage roster (<%= (rosters[t.id]||[]).length %>)</summary><% if(!(rosters[t.id]||[]).length){ %><p class="muted">No one is registered.</p><% } %><% (rosters[t.id]||[]).forEach(r=>{ %><div class="review-answer"><strong><%= r.display_name||r.discord_username||('User #'+r.user_id) %></strong><small><%= r.registration_type %> · <%= r.status.replaceAll('_',' ') %><%= r.result_status!=='pending'?' · '+r.result_status:'' %></small><% if(r.result_status==='pending'&&r.registration_type==='student'){ %><form method="post" action="/training/admin/<%= t.id %>/registrations/<%= r.id %>/complete"><div class="form-grid"><select name="result_status" required><option value="passed">Passed</option><option value="failed">Failed</option><option value="incomplete">Incomplete / no show</option></select><input type="number" name="score" min="0" max="100" step="0.01" placeholder="Score (optional)"></div><textarea name="instructor_notes" placeholder="Instructor notes (optional)"></textarea><button class="btn secondary">Save result</button></form><% }else if(r.result_status!=='pending'){ %><p class="muted"><%= r.score!=null?'Score '+r.score+'% · ':'' %><%= r.instructor_notes||'No instructor notes.' %></p><% } %></div><% }) %></details></div><% } %></div></article><% }) %><% if(history.length){ %><section class="panel"><div class="panel-heading"><div><div class="eyebrow">YOUR RECORD</div><h2>Training history</h2></div></div><% history.forEach(h=>{ %><div class="review-answer"><strong><%= h.title %></strong><p><span class="pill"><%= h.result_status %></span><%= h.score!=null?' · '+h.score+'%':'' %></p><small><%= h.department_name||'Community' %> · <%= new Date(h.completed_at).toLocaleString() %></small><% if(h.instructor_notes){ %><p class="muted"><%= h.instructor_notes %></p><% } %></div><% }) %></section><% } %></section><% if(canManage){ %><aside class="panel"><h2>Create training</h2><p class="muted">Department Command and authorized administrators can configure rosters and record results.</p><form method="post" action="/training/admin/create"><label><span>Training name</span><input name="title" required></label><label><span>Starts</span><input type="datetime-local" name="start_at" required></label><label><span>Ends</span><input type="datetime-local" name="end_at"></label><label><span>Location</span><input name="location"></label><label><span>Instructor seats</span><input type="number" min="1" name="instructor_seats" value="2" required></label><label><span>Student seats</span><input type="number" min="1" name="student_seats" value="10" required></label><label><span>Description</span><textarea name="description"></textarea></label><button class="btn">Create training</button></form></aside><% } %></div><%- include('../partials/footer') %>
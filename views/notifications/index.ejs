<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">YOUR COMMUNITY</div><h1>Notifications</h1><p><span data-notification-count><%= unread %></span> unread · Ticket, training and community updates.</p></div></section><section class="panel"><div class="ticket-filters"><a class="btn secondary" href="/notifications?filter=<%= filter %>">Refresh</a><a class="btn secondary" href="/notifications?filter=all" <%- filter==='all'?'aria-current="page"':'' %>>All</a><a class="btn secondary" href="/notifications?filter=unread" <%- filter==='unread'?'aria-current="page"':'' %>>Unread</a><% if(unread&&cutoff!=='0'){ %><form method="post" action="/notifications/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="filter" value="<%= filter %>"><input type="hidden" name="all" value="1"><input type="hidden" name="cutoff" value="<%= cutoff %>"><button class="btn secondary">Mark all as read</button></form><% } %></div><div class="admin-list"><% if(!notifications.length){ %><p class="muted">No <%= filter==='unread'?'unread ':'' %>notifications.</p><% } %><% notifications.forEach(n=>{ %><article class="admin-row notification-entry"><div><strong><%= n.title %></strong><p class="muted"><%= n.message %></p><small><%= new Date(n.created_at).toLocaleString() %></small><% if(n.url){ %><p><a class="text-link" href="<%= n.url %>">View details →</a></p><% } %></div><% if(!n.is_read){ %><form method="post" action="/notifications/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= n.id %>"><input type="hidden" name="filter" value="<%= filter %>"><button class="btn secondary">Mark as read</button></form><% }else{ %><span class="pill">Read</span><% } %></article><% }) %></div><% if(notifications.length===100){ %><p class="muted">Showing the latest 100 matching notifications.</p><% } %></section><%- include('../partials/footer') %>

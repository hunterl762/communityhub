<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">COMMUNITY HUB</div><h1>Notifications</h1><p>Application, training, LOA and personnel updates.</p></div></section><section class="panel"><div class="admin-list"><% if(!notifications.length){ %><p class="muted">You have no notifications.</p><% } %><% notifications.forEach(n=>{ %><div class="admin-row"><div><strong><%= n.title %></strong><div class="muted"><%= n.message %> · <%= new Date(n.created_at).toLocaleString() %></div><% if(n.url){ %><a class="text-link" href="<%= n.url %>">View details</a><% } %></div><% if(!n.is_read){ %><form method="post" action="/admin/management/notifications/<%= n.id %>/read"><button class="btn secondary">Mark Read</button></form><% }else{ %><span class="pill">read</span><% } %></div><% }) %></div></section><%- include('../partials/footer') %>
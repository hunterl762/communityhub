<%- include('../partials/header') %>
<section class="page-head"><div><p class="eyebrow">Support</p><h1><%= queue?'Staff queue':'My tickets' %></h1><p>Questions, bugs, reports, and appeals.</p></div><div class="actions"><% if(staff){ %><a class="btn secondary" href="/support<%= queue?'':'?queue=1' %>"><%= queue?'My tickets':'Staff queue' %></a><% } %><a class="btn secondary" href="/support/new">New ticket</a></div></section>
<form method="get" class="community-search"><% if(queue){ %><input type="hidden" name="queue" value="1"><% } %><label for="ticket-status">Status</label><select name="status" id="ticket-status"><option value="">All statuses</option><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select><button class="btn secondary">Filter</button></form>
<div class="table-scroll"><table class="community-table"><thead><tr><th>Ticket</th><% if(queue){ %><th>Member</th><% } %><th>Category</th><th>Status</th><th>Last activity</th></tr></thead><tbody><% tickets.forEach(t=>{ %><tr><td><a href="/support/tickets/<%= t.id %>">#<%= t.id %> · <%= t.subject %></a></td><% if(queue){ %><td><%= t.display_name||'Member' %></td><% } %><td><%= t.category %></td><td><%= t.status.replaceAll('_',' ') %></td><td><%= new Date(t.updated_at).toLocaleDateString('en-US') %></td></tr><% }) %></tbody></table></div><% if(!tickets.length){ %><p class="muted">No tickets match this view.</p><% } %>
<%- include('../partials/footer') %>

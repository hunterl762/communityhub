<%- include('../partials/header') %>
<section class="page-head"><div><p class="eyebrow">Communications</p><h1>News & rules</h1><p>Draft, publish, or archive community information.</p></div><div class="actions"><a class="btn secondary" href="/community/manage/news/new">Write news</a><a class="btn secondary" href="/community/manage/rules/new">Add rule</a></div></section>
<% for(const [title,kind,items] of [['News','news',posts],['Rules','rules',rules]]){ %><section class="community-entry"><h2><%= title %></h2><div class="table-scroll"><table class="community-table"><thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><%= item.title %></td><td><%= item.category %></td><td><%= item.status %></td><td><%= new Date(item.updated_at).toLocaleDateString('en-US') %></td><td><a href="/community/manage/<%= kind %>/<%= item.id %>">Edit</a></td></tr><% }) %></tbody></table></div><% if(!items.length){ %><p class="muted">No <%= title.toLowerCase() %> yet.</p><% } %></section><% } %>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<section class="page-head"><div><p class="eyebrow">Communications / <%= kind %></p><h1><%= recordId==='new'?'Create':'Edit' %> <%= kind==='news'?'news post':'rule' %></h1></div><a class="btn secondary" href="/community/manage">Back to content</a></section>
<form method="post" class="community-reading community-editor" action="/community/manage/<%= kind %>/<%= recordId %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Title<input name="title" value="<%= item.title %>" required maxlength="180"></label><label>Category<input name="category" value="<%= item.category %>" required maxlength="80"></label><% if(kind==='news'){ %><label>Summary<textarea name="summary" maxlength="500" rows="3" required><%= item.summary %></textarea></label><label>Tags (comma-separated)<input name="tags" value="<%= item.tags||'' %>" maxlength="300"></label><% }else{ %><label>Order within category<input type="number" name="sort_order" value="<%= item.sort_order %>" min="0" max="100000" required></label><% } %><label><%= kind==='news'?'Article (Markdown supported; embedded HTML and images are disabled)':'Rule text' %><textarea name="body" rows="16" maxlength="<%= kind==='news'?50000:10000 %>" required><%= item.body %></textarea></label><label>Publication status<select name="status"><% ['draft','published','archived'].forEach(s=>{ %><option value="<%= s %>" <%= item.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="btn">Save <%= kind==='news'?'post':'rule' %></button></form>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<section class="page-head"><div><p class="eyebrow">Support / #<%= ticket.id %></p><h1><%= ticket.subject %></h1><p><%= ticket.category %> · <%= ticket.status.replaceAll('_',' ') %></p></div><a class="btn secondary" href="/support<%= staff?'?queue=1':'' %>">Back to tickets</a></section>
<div class="community-reading"><% if(messages.length===200){ %><p class="muted">Showing the latest 200 messages.</p><% } %><% messages.forEach(m=>{ %><article class="community-entry support-message"><p class="muted"><strong><%= m.display_name||'Former member' %></strong> · <%= m.is_staff?'Support staff':'Member' %> · <%= new Date(m.created_at).toLocaleString('en-US') %></p><p class="community-text"><%= m.message %></p></article><% }) %>
<% if(ticket.status!=='closed'){ %><form method="post" action="/support/tickets/<%= ticket.id %>/reply" class="community-editor"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Reply<textarea name="message" rows="6" required maxlength="10000"></textarea></label><button class="btn secondary">Send reply</button></form><% }else{ %><p class="muted">This ticket is closed. Support staff can reopen it.</p><% } %>
<% if(staff){ %><section class="panel"><h2>Assignment & priority</h2><p class="muted">Currently <%= ticket.assigned_name||'unassigned' %> · <%= ticket.priority||'normal' %> priority</p><form method="post" action="/support/tickets/<%= ticket.id %>/triage" class="ticket-filters"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><span>Assigned to</span><select name="assigned_to"><option value="">Unassigned</option><% assignees.forEach(a=>{ %><option value="<%= a.id %>" <%= String(ticket.assigned_to)===String(a.id)?'selected':'' %>><%= a.display_name %></option><% }) %></select></label><label><span>Priority</span><select name="priority"><% priorities.forEach(p=>{ %><option value="<%= p %>" <%= (ticket.priority||'normal')===p?'selected':'' %>><%= p %></option><% }) %></select></label><button class="btn secondary">Save assignment</button></form></section><form method="post" class="community-search" action="/support/tickets/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="change-status">Ticket status</label><select name="status" id="change-status"><% statuses.forEach(s=>{ %><option value="<%= s %>" <%= ticket.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select><button class="btn secondary">Update status</button></form><% } %></div>
<%- include('../partials/footer') %>

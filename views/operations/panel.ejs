<div class="ops-toolbar"><div class="ops-tabs"><button type="button" data-ops-tab="dispatch">Dispatch</button><button type="button" data-ops-tab="cad">CAD records</button><button type="button" data-ops-tab="reports">Report review</button></div><span data-ops-notice role="status">Connecting…</span></div>
<section data-ops-page="dispatch"><div class="ops-columns"><section class="ops-panel"><h3>Postal map & live units</h3><p class="ops-muted">Standard nearest-postal numbering. Search or zoom to show postal codes.</p><div class="postal-map-tools"><label>Find postal<input data-postal-search placeholder="Postal code" maxlength="16"></label><button type="button" data-postal-find>Find</button><button type="button" data-postal-zoom-in aria-label="Zoom in">+</button><button type="button" data-postal-zoom-out aria-label="Zoom out">−</button><button type="button" data-postal-reset>Reset</button><button type="button" data-postal-route hidden disabled>Route to postal</button></div><p data-postal-status class="ops-muted" role="status">Loading postals…</p><svg data-ops-map viewBox="0 0 600 420" aria-label="Postal map with live unit positions" role="img"></svg><div data-ops-units></div></section><section class="ops-panel"><h3>Active calls</h3><div data-ops-calls></div></section></div><details data-ops-command class="ops-panel"><summary>Create a call</summary><form data-ops-form="createCall"><label>Call title<input name="title" maxlength="160" required></label><label>Priority<select name="priority"><option>P3</option><option>P2</option><option>P1</option></select></label><label>Location<input name="location" maxlength="255"></label><label>Postal code<input name="postal_code" maxlength="16" placeholder="Optional; GPS coordinates also fill this automatically"></label><div class="ops-columns"><label>GPS X<input name="position_x" type="number" step="any"></label><label>GPS Y<input name="position_y" type="number" step="any"></label></div><label>Description<textarea name="description" maxlength="5000"></textarea></label><button>Create call</button></form></details><details class="ops-panel"><summary>Call history & activity</summary><div data-ops-history></div></details></section>
<section data-ops-page="cad" hidden><section class="ops-panel"><h3>Person & vehicle lookup</h3><form data-ops-search><label>Name, plate or model<input name="q" maxlength="100" required></label><button>Search records</button></form><div data-ops-search-results></div></section><section class="ops-panel"><h3>Active BOLOs</h3><div data-ops-bolos></div></section><details data-ops-command class="ops-panel"><summary>Add a person record</summary><form data-ops-form="createPerson"><label>Roleplay name<input name="name" maxlength="160" required></label><label>Date of birth<input type="date" name="dob"></label><label>License<select name="license_status"><option>unknown</option><option>valid</option><option>suspended</option><option>revoked</option></select></label><label>Notes<textarea name="notes" maxlength="5000"></textarea></label><button>Save person</button></form></details><details data-ops-command class="ops-panel"><summary>Add a vehicle record</summary><form data-ops-form="createVehicle"><label>Plate<input name="plate" maxlength="16" required></label><label>Model<input name="model" maxlength="120" required></label><label>Color<input name="color" maxlength="80"></label><label>Owner person ID<input type="number" min="1" name="owner_id"></label><label>Notes<textarea name="notes" maxlength="5000"></textarea></label><button>Save vehicle</button></form></details><details data-ops-command class="ops-panel"><summary>Create a BOLO</summary><form data-ops-form="createBolo"><label>Title<input name="title" maxlength="160" required></label><label>Description<textarea name="description" maxlength="5000" required></textarea></label><label>Person ID (optional)<input type="number" min="1" name="person_id"></label><label>Vehicle ID (optional)<input type="number" min="1" name="vehicle_id"></label><button>Create BOLO</button></form></details></section>
<section data-ops-page="reports" hidden><div data-ops-reports></div></section>

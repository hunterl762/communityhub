<%- include('../partials/header') %>
<section class="page-head people-head"><div><div class="eyebrow">PEOPLE / MEMBER RECORD</div><h1><%= member.callsign ? member.callsign+' · ' : '' %><%= member.display_name||member.discord_username %></h1><p><%= member.department_name||'No department assigned' %> · <%= member.rank_name||member.role.replaceAll('_',' ') %> · <span class="pill"><%= member.member_status %></span></p></div><a class="btn secondary" href="/personnel">← People</a></section>
<% if(member.bio){ %><section class="panel member-bio"><h2>About me</h2><p class="community-text"><%= member.bio %></p></section><% } %><nav class="people-summary" aria-label="Member summary"><div><span>Department</span><strong><%= member.department_name||'Unassigned' %></strong></div><div><span>Rank</span><strong><%= member.rank_name||'Unassigned' %></strong></div><div><span>Callsign</span><strong><%= member.callsign||'Unassigned' %></strong></div><div><span>Probation</span><strong><%= staffProfile?.probation_status||'none' %></strong></div><div><span>Activity</span><strong><%= staffProfile?.activity_status||'active' %></strong></div></nav>
<div class="people-layout"><main class="people-main"><section class="people-section"><div class="panel-heading"><div><div class="eyebrow">IDENTITY</div><h2>Member profile</h2></div></div><dl class="people-details"><div><dt>Display name</dt><dd><%= member.display_name||'Not set' %></dd></div><div><dt>Discord</dt><dd><%= member.discord_username||'Not linked' %></dd></div><div><dt>Community role</dt><dd><%= member.role.replaceAll('_',' ') %></dd></div><div><dt>Member status</dt><dd><%= member.member_status %></dd></div></dl></section>
<% if(activityMetrics){ const req=activityMetrics.requirement_minutes;const mins=activityMetrics.patrol_minutes;const met=req==null||mins>=req; %><section class="people-section"><div class="panel-heading"><div><div class="eyebrow">ACTIVITY / LAST 7 DAYS</div><h2>Patrol performance</h2></div><% if(canManage){ %><a href="/staff-activity">Activity roster ↗</a><% } %></div><div class="people-summary"><div><span>Patrol time</span><strong><%= (mins/60).toFixed(1) %>h</strong></div><div><span>Sessions</span><strong><%= activityMetrics.patrol_sessions %></strong></div><div><span>Training</span><strong><%= activityMetrics.training_completed %></strong></div><div><span>Requirement</span><strong><%= req==null?'Not set':(req/60).toFixed(1)+'h' %></strong></div><div><span>Progress</span><strong><%= req==null?'—':activityMetrics.requirement_percent+'%' %></strong></div></div><p><span class="status-badge <%= met?'online':'offline' %>"><%= met?'Requirement met':'Below requirement' %></span><%= activityMetrics.last_patrol?' · Last patrol '+new Date(activityMetrics.last_patrol).toLocaleString():' · No patrol recorded' %></p></section><% } %>
<section class="people-section"><div class="panel-heading"><div><div class="eyebrow">QUALIFICATIONS</div><h2>Certifications</h2></div><span class="muted"><%= certifications.length %> recorded</span></div><% if(!certifications.length){ %><p class="people-empty">No certifications recorded.</p><% } %><% certifications.forEach(c=>{ %><article class="people-row"><div><strong><%= c.name %></strong><small>Awarded <%= new Date(c.awarded_at).toLocaleDateString() %><%= c.expires_at?' · expires '+new Date(c.expires_at).toLocaleDateString():'' %></small></div><span class="pill"><%= c.expires_at&&new Date(c.expires_at)<new Date()?'expired':'current' %></span></article><% }) %></section>
<section class="people-section"><div class="panel-heading"><div><div class="eyebrow">DEVELOPMENT</div><h2>Training history</h2></div></div><% if(!training.length){ %><p class="people-empty">No training history recorded.</p><% } %><% training.forEach(t=>{ %><article class="people-row"><div><strong><%= t.title %></strong><small><%= new Date(t.start_at).toLocaleString() %> · <%= t.registration_type %><%= t.score!=null?' · '+t.score+'%':'' %></small></div><span class="pill"><%= t.result_status&&t.result_status!=='pending'?t.result_status:t.status %></span></article><% }) %></section>
<section class="people-section"><div class="panel-heading"><div><div class="eyebrow">STAFF LIFECYCLE</div><h2>Assignment history</h2></div></div><% if(!staffActions.length){ %><p class="people-empty">No staff assignment changes recorded yet.</p><% } %><% staffActions.forEach(a=>{ %><article class="people-row"><div><strong><%= a.action_type.replaceAll('_',' ') %></strong><small><%= a.from_department_name||a.from_rank||'—' %> → <%= a.to_department_name||a.to_rank||'—' %><%= a.reason?' · '+a.reason:'' %></small></div><small><%= a.performed_by_name||'System' %><br><%= new Date(a.created_at).toLocaleString() %></small></article><% }) %></section>
<section class="people-section"><div class="panel-heading"><div><div class="eyebrow">LEAVE</div><h2>LOA history</h2></div></div><% if(!leaveRequests.length){ %><p class="people-empty">No leave requests recorded.</p><% } %><% leaveRequests.forEach(l=>{ %><article class="people-row"><div><strong><%= new Date(l.start_date).toLocaleDateString() %> – <%= new Date(l.end_date).toLocaleDateString() %></strong><small><%= l.reason||'No reason provided' %></small></div><span class="pill"><%= l.status||'pending' %></span></article><% }) %></section>
<% if(canManage){ %><section class="people-section"><div class="panel-heading"><div><div class="eyebrow">ACTIVITY HISTORY</div><h2>Status changes</h2></div></div><% if(!activityHistory.length){ %><p class="people-empty">No activity status changes recorded.</p><% } %><% activityHistory.forEach(h=>{ %><article class="people-row"><div><strong><%= h.previous_status||'untracked' %> → <%= h.new_status %></strong><small><%= h.reason||'No reason recorded' %></small></div><small><%= h.changed_by_name||'System' %><br><%= new Date(h.created_at).toLocaleString() %></small></article><% }) %></section><section class="people-section"><div class="panel-heading"><div><div class="eyebrow">PRIVATE STAFF RECORD</div><h2>Notes & evaluations</h2></div></div><% if(!staffNotes.length&&!evaluations.length){ %><p class="people-empty">No private staff notes or evaluations.</p><% } %><% staffNotes.forEach(n=>{ %><article class="people-note"><strong><%= n.note_type %></strong><p><%= n.note_text %></p><small><%= n.created_by_name||'System' %> · <%= new Date(n.created_at).toLocaleString() %></small></article><% }) %><% evaluations.forEach(e=>{ %><article class="people-note"><strong><%= e.evaluation_type %> evaluation<%= e.rating?' · '+e.rating+'/5':'' %></strong><p><%= e.summary %></p><small><%= e.evaluator_name||'System' %> · <%= new Date(e.created_at).toLocaleString() %></small></article><% }) %></section><% } %>
<section class="people-section"><div class="panel-heading"><div><div class="eyebrow">PERSONNEL RECORD</div><h2>Discipline & commendations</h2></div></div><% if(!discipline.length){ %><p class="people-empty">No personnel records.</p><% } %><% discipline.forEach(d=>{ %><article class="people-note"><strong><%= d.record_type.replaceAll('_',' ') %></strong><p><%= d.reason %></p><% if(d.action_taken){ %><p><%= d.action_taken %></p><% } %><small><%= d.issued_by_name||'System' %> · <%= new Date(d.created_at).toLocaleString() %></small></article><% }) %></section></main>
<aside class="people-actions"><% if(canManage){ %><section class="people-section"><div class="eyebrow">MANAGEMENT</div><h2>Assignment</h2><form method="post" action="/personnel/<%= member.id %>/profile"><label><span>Department ID</span><input type="number" name="department_id" value="<%= member.department_id||'' %>"></label><label><span>Callsign</span><input name="callsign" value="<%= member.callsign||'' %>"></label><label><span>Rank</span><input name="rank_name" value="<%= member.rank_name||'' %>"></label><label><span>Status</span><select name="member_status"><% ['applicant','recruit','active','loa','inactive','removed'].forEach(s=>{ %><option value="<%= s %>" <%= member.member_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label><span>Reason for assignment/rank change</span><input name="change_reason" placeholder="Required context for history"></label><button class="btn">Save & sync Discord</button></form></section>
<section class="people-section"><div class="eyebrow">STAFF STATUS</div><h2>Probation & activity</h2><form method="post" action="/personnel/<%= member.id %>/staff-profile"><label><span>Probation</span><select name="probation_status"><% ['none','active','completed','extended'].forEach(s=>{ %><option value="<%= s %>" <%= staffProfile?.probation_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label><span>Probation start</span><input type="datetime-local" name="probation_started_at"></label><label><span>Probation end</span><input type="datetime-local" name="probation_ends_at"></label><label><span>Activity status</span><select name="activity_status"><% ['active','watch','inactive','exempt'].forEach(s=>{ %><option value="<%= s %>" <%= (staffProfile?.activity_status||'active')===s?'selected':'' %>><%= s %></option><% }) %></select></label><label><span>Required minutes</span><input type="number" min="0" name="activity_requirement_minutes" value="<%= staffProfile?.activity_requirement_minutes||'' %>"></label><button class="btn">Update staff status</button></form></section>
<section class="people-section"><div class="eyebrow">PRIVATE NOTE</div><h2>Add staff note</h2><form method="post" action="/personnel/<%= member.id %>/notes"><select name="note_type"><% ['general','supervisor','performance','commendation','concern'].forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><textarea name="note_text" required placeholder="Internal staff note"></textarea><button class="btn secondary">Add note</button></form></section>
<section class="people-section"><div class="eyebrow">EVALUATION</div><h2>Record evaluation</h2><form method="post" action="/personnel/<%= member.id %>/evaluations"><select name="evaluation_type"><% ['probation','routine','promotion','training','performance'].forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><label><span>Rating (1–5)</span><input type="number" min="1" max="5" name="rating"></label><textarea name="summary" required placeholder="Evaluation summary"></textarea><div class="form-grid"><input type="date" name="period_start" aria-label="Evaluation period start"><input type="date" name="period_end" aria-label="Evaluation period end"></div><button class="btn secondary">Record evaluation</button></form></section>
<section class="people-section"><div class="eyebrow">CERTIFICATION</div><h2>Award certification</h2><% availableCertifications.forEach(c=>{ %><form class="certification-award" method="post" action="/admin/management/certifications/<%= c.id %>/award"><input type="hidden" name="user_id" value="<%= member.id %>"><label><span><%= c.name %></span><input name="notes" placeholder="Optional note"></label><button class="btn secondary" type="submit">Award</button></form><% }) %></section>
<section class="people-section"><div class="eyebrow">RECORD</div><h2>Add personnel record</h2><form method="post" action="/admin/management/discipline/<%= member.id %>"><select name="record_type"><option value="verbal_warning">Verbal warning</option><option value="written_warning">Written warning</option><option value="strike">Strike</option><option value="suspension">Suspension</option><option value="removal">Removal</option><option value="commendation">Commendation</option><option value="note">Staff note</option></select><textarea name="reason" required placeholder="Reason"></textarea><textarea name="action_taken" placeholder="Action / notes"></textarea><button class="btn">Add record</button></form></section><% } %>
<section class="people-section"><div class="eyebrow">RECRUITMENT</div><h2>Pipeline history</h2><% pipeline.forEach(p=>{ %><article class="people-note"><strong><%= p.stage %></strong><p><%= p.notes||'' %></p><small><%= p.changed_by_name||'System' %> · <%= new Date(p.created_at).toLocaleString() %></small></article><% }) %><% if(canManage){ %><form method="post" action="/personnel/<%= member.id %>/pipeline"><select name="stage"><% ['accepted','recruit','training','evaluation','member','failed','removed'].forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><textarea name="notes" placeholder="Pipeline notes"></textarea><button class="btn secondary">Update stage & sync</button></form><% } %></section></aside></div><%- include('../partials/footer') %>
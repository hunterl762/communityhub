<%- include('../partials/header') %>
<section class="page-head"><div><div class="eyebrow">PERSONNEL FILE</div><h1><%= member.callsign ? member.callsign+' · ' : '' %><%= member.display_name||member.discord_username %></h1><p><%= member.department_name||'No department assigned' %> · <%= member.rank_name||member.role.replaceAll('_',' ') %></p></div></section>
<div class="split"><section>
<article class="panel"><h2>Member Profile</h2><p><strong>Discord:</strong> <%= member.discord_username %></p><p><strong>Callsign:</strong> <%= member.callsign||'Not assigned' %></p><p><strong>Rank:</strong> <%= member.rank_name||'Not assigned' %></p><p><strong>Status:</strong> <span class="pill"><%= member.member_status %></span></p></article>
<article class="panel admin-section"><h2>Certifications</h2><% if(!certifications.length){ %><p class="muted">No certifications recorded.</p><% } %><% certifications.forEach(c=>{ %><div class="review-answer"><strong><%= c.name %></strong><p>Awarded <%= new Date(c.awarded_at).toLocaleDateString() %><%= c.expires_at ? ' · Expires '+new Date(c.expires_at).toLocaleDateString() : '' %></p></div><% }) %></article>
<article class="panel admin-section"><h2>Training History</h2><% training.forEach(t=>{ %><div class="review-answer"><strong><%= t.title %></strong><p><%= new Date(t.start_at).toLocaleString() %> · <%= t.status %></p></div><% }) %></article>
<article class="panel admin-section"><h2>Personnel Records</h2><% if(!discipline.length){ %><p class="muted">No personnel records.</p><% } %><% discipline.forEach(d=>{ %><div class="staff-note"><strong><%= d.record_type.replaceAll('_',' ') %></strong><p><%= d.reason %></p><% if(d.action_taken){ %><p><%= d.action_taken %></p><% } %><small><%= d.issued_by_name||'System' %> · <%= new Date(d.created_at).toLocaleString() %></small></div><% }) %></article>
</section><aside><% if(canManage){ %>
<section class="panel"><h2>Personnel Management</h2><form method="post" action="/personnel/<%= member.id %>/profile"><label><span>Department ID</span><input type="number" name="department_id" value="<%= member.department_id||'' %>"></label><label><span>Callsign</span><input name="callsign" value="<%= member.callsign||'' %>"></label><label><span>Rank</span><input name="rank_name" value="<%= member.rank_name||'' %>"></label><label><span>Status</span><select name="member_status"><% ['applicant','recruit','active','loa','inactive','removed'].forEach(s=>{ %><option value="<%= s %>" <%= member.member_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="btn">Save & Sync Discord</button></form></section>
<section class="panel admin-section"><h2>Award Certification</h2><% availableCertifications.forEach(c=>{ %><form method="post" action="/admin/management/certifications/<%= c.id %>/award"><input type="hidden" name="user_id" value="<%= member.id %>"><input name="notes" placeholder="Optional certification note"><button class="btn secondary" type="submit">Award <%= c.name %></button></form><% }) %></section>
<section class="panel admin-section"><h2>Add Personnel Record</h2><form method="post" action="/admin/management/discipline/<%= member.id %>"><label><span>Record type</span><select name="record_type"><option value="verbal_warning">Verbal warning</option><option value="written_warning">Written warning</option><option value="strike">Strike</option><option value="suspension">Suspension</option><option value="removal">Removal</option><option value="commendation">Commendation</option><option value="note">Staff note</option></select></label><label><span>Reason</span><textarea name="reason" required></textarea></label><label><span>Action / notes</span><textarea name="action_taken"></textarea></label><button class="btn" type="submit">Add Record</button></form></section>
<section class="panel admin-section"><h2>Recruit Pipeline</h2><form method="post" action="/personnel/<%= member.id %>/pipeline"><select name="stage"><% ['accepted','recruit','training','evaluation','member','failed','removed'].forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><textarea name="notes" placeholder="Pipeline notes"></textarea><button class="btn">Update Stage & Sync</button></form></section><% } %>
<section class="panel admin-section"><h2>Pipeline History</h2><% pipeline.forEach(p=>{ %><div class="staff-note"><strong><%= p.stage %></strong><p><%= p.notes||'' %></p><small><%= p.changed_by_name||'System' %> · <%= new Date(p.created_at).toLocaleString() %></small></div><% }) %></section></aside></div><%- include('../partials/footer') %>
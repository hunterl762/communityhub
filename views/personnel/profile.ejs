<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">PERSONNEL FILE</div><h1><%= member.callsign?member.callsign+' · ':'' %><%= member.display_name||member.discord_username %></h1><p><%= member.department_name||'No department assigned' %> · <%= member.rank_name||member.role.replaceAll('_',' ') %></p></div></section><div class="split"><section><article class="panel"><h2>Member Profile</h2><p><strong>Discord:</strong> <%= member.discord_username %></p><p><strong>Callsign:</strong> <%= member.callsign||'Not assigned' %></p><p><strong>Rank:</strong> <%= member.rank_name||'Not assigned' %></p><p><strong>Status:</strong> <span class="pill"><%= member.member_status %></span></p></article><article class="panel admin-section"><h2>Certifications</h2><% certifications.forEach(c=>{ %><div class="review-answer"><strong><%= c.name %></strong><p>Awarded <%= new Date(c.awarded_at).toLocaleDateString() %><%= c.expires_at?' · Expires '+new Date(c.expires_at).toLocaleDateString():'' %></p></div><% }) %><% if(!certifications.length){ %><p class="muted">No certifications recorded.</p><% } %></article><article class="panel admin-section"><h2>Training History</h2><% training.forEach(t=>{ %><div class="review-answer"><strong><%= t.title %></strong><p><%= new Date(t.start_at).toLocaleString() %> · <%= t.status %></p></div><% }) %></article></section><aside><% if(canManage){ %><section class="panel"><h2>Personnel Management</h2><form method="post" action="/personnel/<%= member.id %>/profile"><label><span>Department ID</span><input type="number" name="department_id" value="<%= member.department_id||'' %>"></label><label><span>Callsign</span><input name="callsign" value="<%= member.callsign||'' %>"></label><label><span>Rank</span><input name="rank_name" value="<%= member.rank_name||'' %>"></label><label><span>Status</span><select name="member_status"><% ['applicant','recruit','active','loa','inactive','removed'].forEach(s=>{ %><option value="<%= s %>" <%= member.member_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="btn">Save Profile</button></form></section><section class="panel admin-section"><h2>Recruit Pipeline</h2><form method="post" action="/personnel/<%= member.id %>/pipeline"><select name="stage"><% ['accepted','recruit','training','evaluation','member','failed','removed'].forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><textarea name="notes" placeholder="Pipeline notes"></textarea><button class="btn">Update Stage</button></form></section><% } %><section class="panel admin-section"><h2>Pipeline History</h2><% pipeline.forEach(p=>{ %><div class="staff-note"><strong><%= p.stage %></strong><p><%= p.notes||'' %></p><small><%= p.changed_by_name||'System' %> · <%= new Date(p.created_at).toLocaleString() %></small></div><% }) %></section></aside></div><%- include('../partials/footer') %>
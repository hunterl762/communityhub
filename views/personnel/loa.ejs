<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">PERSONNEL</div><h1>Leave of Absence</h1><p>Submit and review your LOA requests.</p></div></section><div class="split"><section class="panel"><h2>My Requests</h2><% if(!requests.length){ %><p class="muted">You have no LOA requests.</p><% } %><% requests.forEach(r=>{ %><div class="review-answer"><strong><%= new Date(r.start_date).toLocaleDateString() %> – <%= new Date(r.end_date).toLocaleDateString() %></strong><p><%= r.reason %></p><span class="pill"><%= r.status %></span><% if(r.review_note){ %><p class="muted"><%= r.review_note %></p><% } %></div><% }) %></section><aside class="panel"><h2>Request LOA</h2><form method="post" action="/personnel/me/loa"><label><span>Start date</span><input type="date" name="start_date" required></label><label><span>End date</span><input type="date" name="end_date" required></label><label><span>Reason</span><textarea name="reason" required></textarea></label><button class="btn">Submit Request</button></form></aside></div><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">PEOPLE / LEAVE</div><h1>Leave Management</h1><p>Review requests, see who is currently away, and keep activity requirements from penalizing approved leave.</p></div><% if(['admin','management','owner'].includes(user.role)){ %><form method="post" action="/loa-management/restore-expired"><button class="btn secondary">Restore ended leave</button></form><% } %></section><nav class="command-metrics"><div class="command-metric"><span>Awaiting review</span><b><%= pending.length %></b><small>Requests needing a decision</small></div><div class="command-metric"><span>Currently approved</span><b><%= active.length %></b><small>Activity requirements paused</small></div><div class="command-metric"><span>Recent decisions</span><b><%= recent.length %></b><small>Latest approval history</small></div></nav><section class="panel"><div class="panel-heading"><div><div class="eyebrow">QUEUE</div><h2>Requests awaiting review</h2></div></div><% if(!pending.length){ %><p class="muted">No leave requests are waiting for review.</p><% } %><% pending.forEach(l=>{ %><article class="review-answer"><div class="panel-heading"><div><strong><%= l.callsign?l.callsign+' · ':'' %><%= l.display_name||l.discord_username %></strong><small><%= l.department_name||'Unassigned' %> · <%= l.rank_name||'No rank' %></small></div><span class="pill">pending</span></div><p><strong><%= new Date(l.start_date).toLocaleDateString() %> – <%= new Date(l.end_date).toLocaleDateString() %></strong></p><p><%= l.reason||'No reason provided.' %></p><div class="form-grid"><form method="post" action="/loa-management/<%= l.id %>/approve"><input name="review_notes" placeholder="Approval note (optional)"><button class="btn">Approve & pause activity</button></form><form method="post" action="/loa-management/<%= l.id %>/deny"><input name="review_notes" placeholder="Reason / note (optional)"><button class="btn secondary">Deny</button></form></div></article><% }) %></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">CURRENTLY AWAY</div><h2>Approved leave</h2></div></div><% if(!active.length){ %><p class="muted">No members are currently on approved leave.</p><% } %><% active.forEach(l=>{ %><article class="people-row"><div><a href="/personnel/<%= l.user_id %>"><strong><%= l.callsign?l.callsign+' · ':'' %><%= l.display_name||l.discord_username %></strong></a><small><%= l.department_name||'Unassigned' %> · through <%= new Date(l.end_date).toLocaleDateString() %></small></div><span class="status-badge online">Activity exempt</span></article><% }) %></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">HISTORY</div><h2>Recent decisions</h2></div></div><% recent.forEach(l=>{ %><article class="people-row"><div><strong><%= l.display_name||l.discord_username %></strong><small><%= new Date(l.start_date).toLocaleDateString() %> – <%= new Date(l.end_date).toLocaleDateString() %><%= l.review_notes?' · '+l.review_notes:'' %></small></div><div><span class="pill"><%= l.status %></span><small><%= l.reviewer_name||'System' %></small></div></article><% }) %></section><%- include('../partials/footer') %>
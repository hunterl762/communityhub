<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">COMMUNITY PERSONNEL</div><h1>Department Rosters</h1><p>Members, recruits, callsigns, ranks and current personnel status.</p></div><a class="btn secondary" href="/personnel/me/loa">My LOA</a></section><section class="panel"><div class="admin-list"><% if(!members.length){ %><p class="muted">No personnel have been assigned yet.</p><% } %><% members.forEach(m=>{ %><a class="admin-row" href="/personnel/<%= m.id %>"><div><strong><%= m.callsign?m.callsign+' · ':'' %><%= m.display_name||m.discord_username %></strong><div class="muted"><%= m.department_name||'Unassigned' %> · <%= m.rank_name||m.role.replaceAll('_',' ') %></div></div><span class="pill"><%= m.member_status %></span></a><% }) %></div></section><%- include('../partials/footer') %>
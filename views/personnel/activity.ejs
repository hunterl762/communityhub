<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">PEOPLE / ACTIVITY</div><h1>Staff Activity</h1><p>Patrol activity, requirements and supervisor attention in one operational view.</p></div><div class="actions"><a class="btn secondary" href="/staff-activity?days=7">7 days</a><a class="btn secondary" href="/staff-activity?days=14">14 days</a><a class="btn secondary" href="/staff-activity?days=30">30 days</a></div></section><nav class="command-metrics"><div class="command-metric"><span>Tracked members</span><b><%= summary.members %></b><small>Active and recruit personnel</small></div><div class="command-metric"><span>Patrol hours</span><b><%= (summary.minutes/60).toFixed(1) %></b><small>Last <%= days %> days</small></div><div class="command-metric"><span>Below requirement</span><b><%= summary.below %></b><small>Needs supervisor review</small></div><div class="command-metric"><span>Watch</span><b><%= summary.watch %></b><small>Activity watch status</small></div><div class="command-metric"><span>Inactive</span><b><%= summary.inactive %></b><small>Marked inactive</small></div></nav><section class="panel"><div class="panel-heading"><div><div class="eyebrow">PERFORMANCE</div><h2><%= days %>-day activity roster</h2></div><% if(['admin','management','owner'].includes(user.role)){ %><form method="post" action="/staff-activity/snapshot"><input type="hidden" name="days" value="<%= days %>"><button class="btn secondary">Save snapshot</button></form><% } %></div><div class="table-scroll"><table class="community-table"><thead><tr><th>Member</th><th>Department</th><th>Patrol</th><th>Requirement</th><th>Sessions</th><th>Last patrol</th><th>Status</th><th>Manage</th></tr></thead><tbody><% rows.forEach(r=>{ const req=r.activity_requirement_minutes==null?null:Number(r.activity_requirement_minutes);const mins=Number(r.patrol_minutes||0);const met=req===null||mins>=req; %><tr><td><a href="/personnel/<%= r.id %>"><strong><%= r.callsign?r.callsign+' · ':'' %><%= r.display_name||r.discord_username %></strong></a><small><%= r.rank_name||'No rank' %></small></td><td><%= r.department_name||'Unassigned' %></td><td><strong><%= (mins/60).toFixed(1) %>h</strong></td><td><% if(req===null){ %><span class="muted">Not set</span><% }else{ %><span class="status-badge <%= met?'online':'offline' %>"><%= (req/60).toFixed(1) %>h · <%= met?'Met':'Below' %></span><% } %></td><td><%= r.patrol_sessions %></td><td><%= r.last_patrol?new Date(r.last_patrol).toLocaleString():'No patrol recorded' %></td><td><span class="pill"><%= r.activity_status %></span></td><td><details><summary>Manage</summary><form method="post" action="/staff-activity/<%= r.id %>/requirement"><label><span>Required minutes / period</span><input type="number" min="0" name="activity_requirement_minutes" value="<%= req==null?'':req %>" placeholder="No requirement"></label><button class="btn secondary">Save requirement</button></form><form method="post" action="/staff-activity/<%= r.id %>/status"><label><span>Activity status</span><select name="activity_status"><% ['active','watch','inactive','exempt'].forEach(s=>{ %><option value="<%= s %>" <%= r.activity_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label><span>Reason</span><input name="reason" placeholder="Optional supervisor note"></label><button class="btn secondary">Update status</button></form></details></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p class="muted">No staff activity records are available.</p><% } %></section><%- include('../partials/footer') %>
<section class="panel admin-section"><h2>My patrol clock</h2><p>Elapsed duty time <strong role="timer" aria-live="off" data-duty-seconds="<%= patrol?(clockLog.active?.duration_seconds||Math.max(0,Math.floor((Date.now()-new Date(patrol.clocked_in_at).getTime())/1000))):0 %>" data-duty-running="<%= !!patrol %>">00:00:00</strong></p><p><strong><%= patrol?'On duty':'Off duty' %></strong><% if(patrol){ %> since <%= new Date(patrol.clocked_in_at).toLocaleString() %><% } %></p><% if(clockMessage){ %><p role="status" class="muted"><%= clockMessage %></p><% } %><% if(patrol){ %><form method="post" action="/fivem/clock-out"><button class="btn secondary">Clock out</button></form><% }else{ %><form method="post" action="/fivem/clock-in"><label><span>Patrol server</span><select name="server_key" required><% servers.forEach(s=>{ %><option value="<%= s.server_key %>"><%= s.name %></option><% }) %></select></label><button class="btn" <%= !servers.length?'disabled':'' %>>Clock in</button></form><% } %><h3>My recent sessions</h3><div class="status-history"><% clockLog.sessions.forEach(p=>{ %><article class="history-row"><strong><%= p.server_name||'Community' %> · <%= p.status==='active'?'On duty':'Completed' %></strong><p><%= new Date(p.clocked_in_at).toLocaleString() %> → <%= p.clocked_out_at?new Date(p.clocked_out_at).toLocaleString():'Ongoing' %></p><small><%= Math.floor(p.duration_seconds/3600) %>h <%= Math.floor(p.duration_seconds%3600/60) %>m</small></article><% }) %><% if(!clockLog.sessions.length){ %><p class="muted">No patrol sessions yet.</p><% } %></div></section>

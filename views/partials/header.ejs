<!doctype html>
<html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><% const meta=typeof siteMetadata!=='undefined'?siteMetadata:null; %><title><%= meta?meta.title:communityName %></title><% if(meta){ %><meta name="description" content="<%= meta.description %>"><meta property="og:type" content="website"><meta property="og:site_name" content="<%= communityName %>"><meta property="og:title" content="<%= meta.title %>"><meta property="og:description" content="<%= meta.description %>"><meta property="og:url" content="<%= meta.url %>"><meta property="og:image" content="<%= meta.image %>"><meta property="og:image:alt" content="<%= communityName %> logo"><meta name="twitter:card" content="summary"><meta name="twitter:title" content="<%= meta.title %>"><meta name="twitter:description" content="<%= meta.description %>"><meta name="twitter:image" content="<%= meta.image %>"><% } %><link rel="icon" href="/branding/icon?v=<%= typeof communityLogoVersion!=='undefined'?communityLogoVersion:'default' %>"><script>document.documentElement.classList.add('js');try{const m=document.cookie.match(/(?:^|; )communityhub_theme=(light|dark|system)(?:;|$)/);const t=m?m[1]:'dark';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;}catch{}</script><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/community.css"><link rel="stylesheet" href="/css/command.css"><link rel="stylesheet" href="/css/v3-people.css"><link rel="stylesheet" href="/css/community-content.css"><link rel="stylesheet" href="/css/v3-command-center.css"><link rel="stylesheet" href="/css/theme.css"><script src="/js/duty-timer.js" defer></script><script src="/js/navigation.js" defer></script></head><body class="<%= user?'hub-app top-navigation':'public-site top-navigation' %>">
<% const role=user?.role;const review=['reviewer','department_command','staff','admin','management','owner'].includes(role);const manage=['department_command','staff','admin','management','owner'].includes(role);const configure=['admin','management','owner'].includes(role);const members=['admin','owner'].includes(role);const here=typeof currentPath==='string'?currentPath:'';const link=(url)=>here===url||(url!=='/'&&url!=='/overview'&&here.startsWith(url+'/'));const navGroups=[{name:'Operations',items:[['/fivem','Live operations','signal'],['/fivem/status','Integration status','status'],['/reports','Reports','file']]},{name:'People & Community',items:[['/personnel','People','users'],['/applications','Applications','file'],['/lms','My Training','file'],['/training','Training sessions','calendar'],['/calendar','Calendar','calendar'],['/news','News','file'],['/rules','Rules','file'],['/support','Support','bell'],['/home','Community home','grid'],['/about','About','users'],['/gallery','Gallery','folder'],['/documents','Documents','folder']]},{name:'Administration',items:[...(['staff','admin','management','owner'].includes(role)?[['/community/manage','News & rules','file']]:[]),...(review?[['/admin','Admin Center','grid']]:[]),...(manage?[['/admin/management','Community management','users'],['/admin/management/notifications','Notifications','bell']]:[]),...(configure?[['/admin/fivem','FiveM configuration','settings'],['/admin/application-builder','Application builder','file'],['/admin/appearance','Appearance & in-game','settings'],['/admin/website','Website content','settings']]:[]),...(members?[['/admin/users','Accounts & roles','users']]:[]),...(role==='owner'?[['/admin#community-settings','Community settings','settings']]:[])]}];const selectedUrl=['/overview','/account',...navGroups.flatMap(g=>g.items.map(i=>i[0]))].filter(url=>!url.includes('#')&&link(url)).sort((a,b)=>b.length-a.length)[0]; %>

<% const memberPaths=['/lms','/training','/calendar','/documents'];const topGroups=navGroups.map(g=>({...g,items:g.items.filter(i=>!memberPaths.includes(i[0]))}));topGroups.splice(2,0,{name:'Members',items:navGroups.flatMap(g=>g.items).filter(i=>memberPaths.includes(i[0]))});const publicGroups=[{name:'Operations',items:[['/overview','Overview','grid'],['/fivem/status','Server status','signal'],['/reports','Reports','file']]},{name:'Community',items:[['/personnel','People','users'],['/news','News','file'],['/rules','Rules','file'],['/about','About','users'],['/gallery','Gallery','folder'],['/applications','Recruitment','file'],['/support','Support','bell']]},{name:'Members',items:topGroups.find(g=>g.name==='Members').items}];const groups=user?topGroups:publicGroups; %>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="community-topnav"><div class="topnav-inner">
<a class="hub-brand" href="<%= user?'/overview':'/' %>"><span class="brand-seal <%= typeof communityLogo!=='undefined'&&communityLogo?'brand-logo':'' %>" aria-hidden="true"><% if(typeof communityLogo!=='undefined'&&communityLogo){ %><img src="<%= communityLogo %>" alt=""><% }else{ %><%= communityName.split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase() %><% } %></span><span><%= communityName %><small>Community Hub</small></span></a>
<button class="icon-button topnav-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="Open navigation"><%- include('ui-icon',{name:'menu'}) %></button>
<nav id="site-navigation" class="topnav-links" aria-label="Main navigation"><a class="topnav-home" href="<%= user?'/overview':'/' %>" <%- (here==='/'||here==='/home'||here==='/overview')?'aria-current="page"':'' %>><%= user?'Overview':'Home' %></a>
<% groups.filter(g=>g.items.length).forEach(g=>{ %><details class="topnav-group"><summary class="<%= g.items.some(i=>link(i[0]))?'current-group':'' %>"><%= g.name==='People & Community'?'Community':g.name %></summary><div class="topnav-dropdown"><% g.items.forEach(([url,label,icon])=>{ %><a href="<%= url %>" <%- (selectedUrl===url||(!user&&here===url))?'aria-current="page"':'' %>><%- include('ui-icon',{name:icon}) %><span><%= label %></span></a><% }) %></div></details><% }) %></nav>
<div class="topnav-actions"><% if(user){ %><button class="icon-button" id="search-open" aria-label="Find a page"><%- include('ui-icon',{name:'search'}) %></button><% if(manage){ %><a class="notification-button" href="/admin/management/notifications" aria-label="Notifications<%= unreadNotifications?', '+unreadNotifications+' unread':'' %>"><%- include('ui-icon',{name:'bell'}) %><% if(unreadNotifications){ %><span><%= unreadNotifications %></span><% } %></a><% } %><% } %>
<label class="theme-control"><span class="sr-only">Color theme</span><select data-theme-control aria-label="Color theme"><option value="light">Light</option><option value="dark">Dark</option><option value="system">System</option></select></label>
<% if(user){ %><details class="account-dropdown"><summary><%- include('account-avatar',{person:user}) %><span class="account-brief"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></span><span class="sr-only">Account menu</span></summary><div class="nav-menu-links"><span class="nav-identity"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></span><a href="/account">Account settings & bio</a><form class="nav-form" method="post" action="/auth/logout"><button class="nav-link-button">Log out</button></form></div></details><% }else{ %><a class="btn secondary topnav-login" href="/auth/login">Sign in with Discord</a><% } %></div>
</div></header>

<% if(user){ %><dialog class="page-search" id="page-search" aria-labelledby="page-search-title"><div class="search-title"><h2 id="page-search-title">Find a page</h2><button class="icon-button" id="search-close" aria-label="Close page search">×</button></div><label for="page-search-input" class="sr-only">Search permitted pages</label><input id="page-search-input" type="search" placeholder="Search people, operations, training, settings…" autocomplete="off"><div class="search-results"><% [['/overview','Command Center'],['/account','Account settings'],...navGroups.flatMap(g=>g.items)].forEach(([url,label])=>{ %><a href="<%= url %>" data-search-link><%= label %><span aria-hidden="true">↗</span></a><% }) %><p id="search-empty" hidden>No matching pages.</p></div></dialog><% } %><main id="main-content" tabindex="-1">

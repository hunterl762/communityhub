<!doctype html>
<html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><% const meta=typeof siteMetadata!=='undefined'?siteMetadata:null; %><title><%= meta?meta.title:communityName %></title><% if(meta){ %><meta name="description" content="<%= meta.description %>"><meta property="og:type" content="website"><meta property="og:site_name" content="<%= communityName %>"><meta property="og:title" content="<%= meta.title %>"><meta property="og:description" content="<%= meta.description %>"><meta property="og:url" content="<%= meta.url %>"><meta property="og:image" content="<%= meta.image %>"><meta property="og:image:alt" content="<%= communityName %> logo"><meta name="twitter:card" content="summary"><meta name="twitter:title" content="<%= meta.title %>"><meta name="twitter:description" content="<%= meta.description %>"><meta name="twitter:image" content="<%= meta.image %>"><% } %><link rel="icon" href="/branding/icon?v=<%= typeof communityLogoVersion!=='undefined'?communityLogoVersion:'default' %>"><script>document.documentElement.classList.add('js');try{const m=document.cookie.match(/(?:^|; )communityhub_theme=(light|dark|system)(?:;|$)/);const t=m?m[1]:'dark';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;}catch{}</script><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/community.css"><link rel="stylesheet" href="/css/command.css"><link rel="stylesheet" href="/css/v3-people.css"><link rel="stylesheet" href="/css/community-content.css"><link rel="stylesheet" href="/css/v3-command-center.css"><link rel="stylesheet" href="/css/theme.css"><script src="/js/duty-timer.js" defer></script><script src="/js/navigation.js" defer></script></head><body class="<%= user?'hub-app':'public-site' %>">
<% const role=user?.role;const review=['reviewer','department_command','staff','admin','management','owner'].includes(role);const manage=['department_command','staff','admin','management','owner'].includes(role);const configure=['admin','management','owner'].includes(role);const members=['admin','owner'].includes(role);const here=typeof currentPath==='string'?currentPath:'';const link=(url)=>here===url||(url!=='/'&&url!=='/overview'&&here.startsWith(url+'/'));const navGroups=[{name:'Operations',items:[['/fivem','Live operations','signal'],['/fivem/status','Integration status','status'],['/reports','Reports','file']]},{name:'People & Community',items:[['/personnel','People','users'],['/applications','Applications','file'],['/lms','My Training','file'],['/training','Training sessions','calendar'],['/calendar','Calendar','calendar'],['/news','News','file'],['/rules','Rules','file'],['/support','Support','bell'],['/home','Community home','grid'],['/about','About','users'],['/gallery','Gallery','folder'],['/documents','Documents','folder']]},{name:'Administration',items:[...(['staff','admin','management','owner'].includes(role)?[['/community/manage','News & rules','file']]:[]),...(review?[['/admin','Admin Center','grid']]:[]),...(manage?[['/admin/management','Community management','users'],['/admin/management/notifications','Notifications','bell']]:[]),...(configure?[['/admin/fivem','FiveM configuration','settings'],['/admin/application-builder','Application builder','file'],['/admin/appearance','Appearance & in-game','settings'],['/admin/website','Website content','settings']]:[]),...(members?[['/admin/users','Accounts & roles','users']]:[]),...(role==='owner'?[['/admin#community-settings','Community settings','settings']]:[])]}];const selectedUrl=['/overview','/account',...navGroups.flatMap(g=>g.items.map(i=>i[0]))].filter(url=>!url.includes('#')&&link(url)).sort((a,b)=>b.length-a.length)[0]; %>
<a class="skip-link" href="#main-content">Skip to content</a>
<% if(user){ %><div class="drawer-backdrop" data-drawer-close></div><aside class="hub-sidebar" id="hub-navigation" aria-label="Workspace navigation"><a class="hub-brand" href="/overview"><span class="brand-seal <%= typeof communityLogo!=='undefined'&&communityLogo?'brand-logo':'' %>" aria-hidden="true"><% if(typeof communityLogo!=='undefined'&&communityLogo){ %><img src="<%= communityLogo %>" alt=""><% }else{ %><%= communityName.split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase() %><% } %></span><span><%= communityName %><small>Community operations</small></span></a><button class="icon-button drawer-close" data-drawer-close aria-label="Close navigation">×</button><nav class="hub-navigation"><a class="hub-nav-link <%= selectedUrl==='/overview'?'selected':'' %>" href="/overview" <%- selectedUrl==='/overview'?'aria-current="page"':'' %>><%- include('ui-icon',{name:'grid'}) %>Command Center</a><% navGroups.filter(g=>g.items.length).forEach(g=>{ %><div class="nav-group"><h2><%= g.name %></h2><% g.items.forEach(([url,label,icon])=>{ %><a class="hub-nav-link <%= selectedUrl===url?'selected':'' %>" href="<%= url %>" <%- selectedUrl===url?'aria-current="page"':'' %>><%- include('ui-icon',{name:icon}) %><span><%= label %></span><% if(url.endsWith('/notifications')&&unreadNotifications){ %><span class="nav-count"><%= unreadNotifications %></span><% } %></a><% }) %></div><% }) %></nav><div class="sidebar-foot"><span class="community-label"><%= communityName %></span><a href="/account"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></a></div></aside>
<header class="hub-topbar"><div class="topbar-start"><button class="icon-button drawer-toggle" id="drawer-toggle" aria-controls="hub-navigation" aria-expanded="false" aria-label="Open navigation"><%- include('ui-icon',{name:'menu'}) %></button><span class="workspace-label">Community operations</span></div><button class="quick-search" id="search-open" aria-label="Find a page"><%- include('ui-icon',{name:'search'}) %><span>Find a page…</span><kbd>/</kbd></button><div class="topbar-actions"><% if(manage){ %><a class="notification-button" href="/admin/management/notifications" aria-label="Notifications<%= unreadNotifications?', '+unreadNotifications+' unread':'' %>"><%- include('ui-icon',{name:'bell'}) %><% if(unreadNotifications){ %><span><%= unreadNotifications %></span><% } %></a><% } %><label class="theme-control"><span class="sr-only">Color theme</span><select data-theme-control aria-label="Color theme"><option value="light">Light</option><option value="dark">Dark</option><option value="system">System</option></select></label><details class="account-dropdown"><summary><span class="avatar-initial" aria-hidden="true"><%= (user.display_name||user.discord_username||'M').slice(0,1).toUpperCase() %></span><span class="account-brief"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></span><span class="sr-only">Account menu</span></summary><div class="nav-menu-links"><span class="nav-identity"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></span><a href="/account">Account settings</a><form class="nav-form" method="post" action="/auth/logout"><button class="nav-link-button">Log out</button></form></div></details></div></header>
<dialog class="page-search" id="page-search" aria-labelledby="page-search-title"><div class="search-title"><h2 id="page-search-title">Find a page</h2><button class="icon-button" id="search-close" aria-label="Close page search">×</button></div><label for="page-search-input" class="sr-only">Search permitted pages</label><input id="page-search-input" type="search" placeholder="Search people, operations, training, settings…" autocomplete="off"><div class="search-results"><% [['/overview','Command Center'],['/account','Account settings'],...navGroups.flatMap(g=>g.items)].forEach(([url,label])=>{ %><a href="<%= url %>" data-search-link><%= label %><span aria-hidden="true">↗</span></a><% }) %><p id="search-empty" hidden>No matching pages.</p></div></dialog>
<nav class="mobile-bottom" aria-label="Mobile navigation"><a href="/overview" <%- here==='/overview'?'aria-current="page"':'' %>><%- include('ui-icon',{name:'grid'}) %>Command</a><a href="/fivem" <%- here.startsWith('/fivem')?'aria-current="page"':'' %>><%- include('ui-icon',{name:'signal'}) %>Live</a><a href="/personnel" <%- here.startsWith('/personnel')?'aria-current="page"':'' %>><%- include('ui-icon',{name:'users'}) %>People</a><button data-drawer-open><%- include('ui-icon',{name:'menu'}) %>More</button></nav>
<% }else{ %><header class="site-header community-public-header"><a class="hub-brand" href="/"><span class="brand-seal <%= typeof communityLogo!=='undefined'&&communityLogo?'brand-logo':'' %>" aria-hidden="true"><% if(typeof communityLogo!=='undefined'&&communityLogo){ %><img src="<%= communityLogo %>" alt=""><% }else{ %><%= communityName.split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase() %><% } %></span><span><%= communityName %></span></a><button class="public-menu-toggle icon-button" type="button" aria-controls="public-menu" aria-expanded="false" aria-label="Open menu"><%- include('ui-icon',{name:'menu'}) %></button><nav class="site-nav" id="public-menu" aria-label="Main navigation"><a href="/" <%- (here==='/'||here==='/home')?'aria-current="page"':'' %>>Home</a><a href="/overview">Overview</a><a href="/fivem/status">Server status</a><a href="/personnel">People</a><a href="/news">News</a><a href="/rules">Rules</a><a href="/about">About</a><a href="/gallery">Gallery</a><a href="/applications">Recruitment</a><a href="/reports">Reports</a><a href="/support">Support</a><a class="login-link" href="/auth/login">Sign in with Discord ↗</a></nav></header><% } %><main id="main-content" tabindex="-1">

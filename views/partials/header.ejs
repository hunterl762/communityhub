<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%= communityName %></title><script>document.documentElement.classList.add('js');try{const m=document.cookie.match(/(?:^|; )communityhub_theme=(light|dark|system)(?:;|$)/);const t=m?m[1]:'light';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;}catch{}</script><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/civic.css"><script src="/js/navigation.js" defer></script></head><body class="<%= user?'hub-app':'public-site' %>">
<% const role=user?.role;const review=['reviewer','department_command','staff','admin','management','owner'].includes(role);const manage=['department_command','staff','admin','management','owner'].includes(role);const configure=['admin','management','owner'].includes(role);const members=['admin','owner'].includes(role);const here=typeof currentPath==='string'?currentPath:'';const link=(url)=>here===url||(url!=='/'&&url!=='/overview'&&here.startsWith(url+'/'));const navGroups=[{name:'Operations',items:[['/fivem','Live operations','signal'],['/fivem/status','Server status','status'],['/reports','Reports','file']]},{name:'Community',items:[['/personnel','Personnel','users'],['/applications','Applications','file'],['/training','Training','calendar'],['/calendar','Calendar','calendar'],['/documents','Documents','folder']]},{name:'Management',items:[...(review?[['/admin','Admin Center','grid']]:[]),...(manage?[['/admin/management','Community management','users'],['/admin/management/notifications','Notifications','bell']]:[]),...(configure?[['/admin/fivem','FiveM configuration','settings'],['/admin/application-builder','Application builder','file']]:[]),...(members?[['/admin/users','Members & roles','users']]:[]),...(role==='owner'?[['/admin#community-settings','Community settings','settings']]:[])]}];const selectedUrl=['/overview','/account',...navGroups.flatMap(g=>g.items.map(i=>i[0]))].filter(url=>!url.includes('#')&&link(url)).sort((a,b)=>b.length-a.length)[0]; %>
<a class="skip-link" href="#main-content">Skip to content</a>
<% if(user){ %><div class="drawer-backdrop" data-drawer-close></div><aside class="hub-sidebar" id="hub-navigation" aria-label="Workspace navigation"><a class="hub-brand" href="/overview"><span class="brand-seal" aria-hidden="true">CH</span><span><%= communityName %><small>Community operations</small></span></a><button class="icon-button drawer-close" data-drawer-close aria-label="Close navigation">×</button><nav class="hub-navigation"><a class="hub-nav-link <%= selectedUrl==='/overview'?'selected':'' %>" href="/overview" <%- selectedUrl==='/overview'?'aria-current="page"':'' %>><%- include('ui-icon',{name:'grid'}) %>Overview</a><% navGroups.filter(g=>g.items.length).forEach(g=>{ %><div class="nav-group"><h2><%= g.name %></h2><% g.items.forEach(([url,label,icon])=>{ %><a class="hub-nav-link <%= selectedUrl===url?'selected':'' %>" href="<%= url %>" <%- selectedUrl===url?'aria-current="page"':'' %>><%- include('ui-icon',{name:icon}) %><span><%= label %></span><% if(url.endsWith('/notifications')&&unreadNotifications){ %><span class="nav-count"><%= unreadNotifications %></span><% } %></a><% }) %></div><% }) %></nav><div class="sidebar-foot"><span class="civic-label">CIVIC / COMMUNITY HUB</span><a href="/account"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></a></div></aside>
<header class="hub-topbar"><div class="topbar-start"><button class="icon-button drawer-toggle" id="drawer-toggle" aria-controls="hub-navigation" aria-expanded="false" aria-label="Open navigation"><%- include('ui-icon',{name:'menu'}) %></button><span class="workspace-label">Community workspace</span></div><button class="quick-search" id="search-open" aria-label="Find a page"><%- include('ui-icon',{name:'search'}) %><span>Find a page…</span><kbd>/</kbd></button><div class="topbar-actions"><label class="theme-control"><span class="sr-only">Color theme</span><select data-theme-control aria-label="Color theme"><option value="light">Light</option><option value="dark">Dark</option><option value="system">System</option></select></label><details class="account-dropdown"><summary><span class="avatar-initial" aria-hidden="true"><%= (user.display_name||user.discord_username||'M').slice(0,1).toUpperCase() %></span><span class="sr-only">Account menu</span></summary><div class="nav-menu-links"><span class="nav-identity"><%= user.display_name||user.discord_username||'Your account' %><small><%= (role||'member').replaceAll('_',' ') %></small></span><a href="/account">Account settings</a><form class="nav-form" method="post" action="/auth/logout"><button class="nav-link-button">Log out</button></form></div></details></div></header>
<dialog class="page-search" id="page-search" aria-labelledby="page-search-title"><div class="search-title"><h2 id="page-search-title">Find a page</h2><button class="icon-button" id="search-close" aria-label="Close page search">×</button></div><label for="page-search-input" class="sr-only">Search permitted pages</label><input id="page-search-input" type="search" placeholder="Search operations, training, settings…" autocomplete="off"><div class="search-results"><% [['/overview','Overview'],['/account','Account settings'],...navGroups.flatMap(g=>g.items)].forEach(([url,label])=>{ %><a href="<%= url %>" data-search-link><%= label %><span aria-hidden="true">↗</span></a><% }) %><p id="search-empty" hidden>No matching pages.</p></div></dialog>
<nav class="mobile-bottom" aria-label="Mobile navigation"><a href="/overview" <%- here==='/overview'?'aria-current="page"':'' %>><%- include('ui-icon',{name:'grid'}) %>Overview</a><a href="/fivem" <%- here.startsWith('/fivem')?'aria-current="page"':'' %>><%- include('ui-icon',{name:'signal'}) %>Live</a><a href="/reports" <%- here.startsWith('/reports')?'aria-current="page"':'' %>><%- include('ui-icon',{name:'file'}) %>Reports</a><button data-drawer-open><%- include('ui-icon',{name:'menu'}) %>More</button></nav>
<% }else{ %><header class="site-header civic-public-header"><a class="hub-brand" href="/"><span class="brand-seal" aria-hidden="true">CH</span><span><%= communityName %></span></a><nav class="site-nav" aria-label="Main navigation"><a href="/" <%- here==='/'?'aria-current="page"':'' %>>Home</a><a href="/#community">Community</a><a href="/applications">Recruitment</a><a class="login-link" href="/auth/login">Sign in with Discord ↗</a></nav></header><% } %><main id="main-content" tabindex="-1">

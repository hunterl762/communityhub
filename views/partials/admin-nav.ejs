<% const adminRole=user.role; const adminHere=typeof currentPath==='string'?currentPath:''; const adminLinks=[['/admin','Overview']]; if(['department_command','staff','admin','management','owner'].includes(adminRole))adminLinks.push(['/admin/management','Community management']); if(['admin','management','owner'].includes(adminRole))adminLinks.push(['/admin/fivem','FiveM configuration'],['/admin/application-builder','Application builder'],['/admin/appearance','Appearance & tablet']); if(['admin','owner'].includes(adminRole))adminLinks.push(['/admin/users','Members & roles']); %>
<nav class="admin-nav" aria-label="Administration"><% adminLinks.forEach(([url,label])=>{ %><a href="<%= url %>" <%- (url==='/admin'?adminHere===url:adminHere===url||adminHere.startsWith(url+'/'))?'aria-current="page"':'' %>><%= label %></a><% }) %></nav>

<section class="panel admin-section"><div class="server-title"><h2>Time clock log</h2><a href="/fivem">My patrol clock →</a></div><p class="muted">Latest 100 patrol sessions. Web and in-game clock actions share one log.</p><div data-patrol-log class="status-history"><% clockLog.sessions.forEach(p=>{ %><article class="history-row"><div><strong><%= p.display_name||p.discord_username||'Member' %></strong><span class="status-badge <%= p.status==='active'?'online':'' %>"><%= p.status==='active'?'On duty':'Completed' %></span></div><p><%= p.server_name||'Community' %> · <%= p.department_name||'Unassigned' %> · <%= p.callsign||'No callsign' %></p><p><%= new Date(p.clocked_in_at).toLocaleString() %> → <%= p.clocked_out_at?new Date(p.clocked_out_at).toLocaleString():'On duty' %></p><small role="timer" aria-live="off" data-duty-seconds="<%= p.duration_seconds %>" data-duty-running="<%= p.status==='active' %>"><%= Math.floor(p.duration_seconds/3600) %>h <%= Math.floor(p.duration_seconds%3600/60) %>m</small></article><% }) %><% if(!clockLog.sessions.length){ %><p class="muted">No patrol clock records yet.</p><% } %></div><details class="admin-disclosure"><summary>Clock event audit</summary><div data-clock-events class="disclosure-body"><% clockLog.events.forEach(e=>{ %><p><strong><%= e.display_name||e.discord_username %></strong> · <%= e.event_type==='clock_in'?'Clocked in':'Clocked out' %> · <%= e.source==='web'?'Website':'In game' %> · <%= new Date(e.occurred_at).toLocaleString() %></p><% }) %><% if(!clockLog.events.length){ %><p class="muted">New clock actions will appear here.</p><% } %></div></details></section>

<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">ACCOUNT SETTINGS</div><h1><%= account.display_name || account.username %></h1><p>Manage your Community Hub identity and connected accounts.</p></div></section><% if(linked){ %><div class="alert success">Discord account linked successfully.</div><% } %><% if(error){ %><div class="alert"><%= error %></div><% } %><section class="grid two"><article class="panel"><h2>Email account</h2><p><strong>Email:</strong> <%= account.email || 'No email connected' %></p><p><strong>Status:</strong> <%= account.email_verified ? 'Verified' : 'Not verified' %></p><p class="muted">Email login gives you a separate way to access Community Hub.</p></article><article class="panel"><h2>Discord account</h2><% if(account.discord_id){ %><div class="account-row"><% if(account.avatar_url){ %><img class="account-avatar" src="<%= account.avatar_url %>" alt="Discord avatar"><% } %><div><strong><%= account.discord_username || account.username %></strong><div class="muted">Discord ID: <%= account.discord_id %></div></div></div><p class="success-text">Connected</p><form method="post" action="/account/discord/unlink"><button class="btn secondary" type="submit">Unlink Discord</button></form><% }else{ %><p>Your Discord account is not linked. Linking it allows Community Hub to associate applications, reports, training attendance and community permissions with your Discord identity.</p><a class="btn discord-btn" href="/auth/discord/link">Link Discord Account</a><% } %></article></section><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">ACCOUNT SETTINGS</div><h1><%= account.display_name || account.username %></h1><p>Your Community Hub account is authenticated through Discord.</p></div></section><% if(error){ %><div class="alert"><%= error %></div><% } %><section class="grid two"><article class="panel"><h2>Discord account</h2><% if(account.discord_id){ %><div class="account-row"><% if(account.avatar_url){ %><img class="account-avatar" src="<%= account.avatar_url %>" alt="Discord avatar"><% } %><div><strong><%= account.discord_username || account.username %></strong><div class="muted">Discord ID: <%= account.discord_id %></div></div></div><p class="success-text">Connected</p><p class="muted">Discord is your Community Hub sign-in method. To change Discord accounts, log out of Community Hub and authenticate with the account you want to use.</p><% }else{ %><p class="alert">This account does not have a Discord identity attached. Log out and sign back in with Discord.</p><% } %></article><article class="panel"><h2>Profile information</h2><p><strong>Display name:</strong> <%= account.display_name || account.username %></p><p><strong>Email from Discord:</strong> <%= account.email || 'Not provided by Discord' %></p><p><strong>Community role:</strong> <%= account.role %></p><p class="muted">Your email is supplied by Discord when available. Community Hub does not use email/password authentication.</p></article></section><section class="panel bio-editor"><h2>Your bio</h2><p class="muted">Introduce yourself to the community. Your bio is visible on your public member profile.</p><% if(typeof saved!=='undefined'&&saved){ %><p class="success-text" role="status">Your bio has been saved.</p><% } %><form method="post" action="/account/bio"><input type="hidden" name="_csrf" value="<%= typeof csrf!=='undefined'?csrf:'' %>"><label for="user-bio">About me</label><textarea id="user-bio" name="bio" maxlength="1000" rows="5" aria-describedby="bio-limit"><%= account.bio||'' %></textarea><small id="bio-limit">Up to 1,000 characters. Leave blank to remove your bio.</small><button class="btn">Save bio</button></form></section><%- include('../partials/footer') %>
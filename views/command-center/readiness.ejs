<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow">COMMAND / READINESS</div><h1>Department Readiness</h1><p>Live FiveM staffing against the minimum coverage command expects.</p></div><a class="btn secondary" href="/command-center">← Command Center</a></section><% if(alerts.length){ %><section class="panel"><div class="panel-heading"><div><div class="eyebrow">ACTIVE ALERTS</div><h2>Coverage problems</h2></div><span class="pill"><%= alerts.length %> open</span></div><% alerts.forEach(a=>{ %><article class="review-answer"><div class="panel-heading"><div><strong><%= a.title %></strong><small><%= a.department_name||'Community' %></small></div><span class="status-badge <%= a.severity==='critical'?'offline':'' %>"><%= a.severity %></span></div><p><%= a.message %></p></article><% }) %></section><% } %><section class="panel"><div class="panel-heading"><div><div class="eyebrow">LIVE COVERAGE</div><h2>Departments</h2></div><span class="muted">Units seen within 90 seconds</span></div><div class="table-scroll"><table class="community-table"><thead><tr><th>Department</th><th>On duty</th><th>Available</th><th>Supervisors</th><th>Target</th><th>Readiness</th><th>Configuration</th></tr></thead><tbody><% departments.forEach(d=>{ %><tr><td><strong><%= d.name %></strong></td><td><%= d.on_duty %></td><td><%= d.available %></td><td><%= d.supervisors %>/<%= d.minimum_supervisors %></td><td><%= d.on_duty %>/<%= d.minimum_on_duty %></td><td><span class="status-badge <%= d.state==='ready'?'online':d.state==='critical'?'offline':'' %>"><%= d.state %></span></td><td><% if(['admin','management','owner'].includes(user.role)){ %><details><summary>Targets</summary><form method="post" action="/command-center/readiness/<%= d.id %>"><label><span>Minimum on duty</span><input type="number" min="0" max="100" name="minimum_on_duty" value="<%= d.minimum_on_duty %>"></label><label><span>Minimum supervisors</span><input type="number" min="0" max="100" name="minimum_supervisors" value="<%= d.minimum_supervisors %>"></label><label><input type="checkbox" name="warning_when_below" value="1" <%= Number(d.warning_when_below)?'checked':'' %>> Alert when below target</label><label><input type="checkbox" name="critical_when_empty" value="1" <%= Number(d.critical_when_empty)?'checked':'' %>> Critical when no units are on duty</label><button class="btn secondary">Save targets</button></form></details><% }else{ %><span class="muted">Command configured</span><% } %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>
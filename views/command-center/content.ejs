<nav class="command-metrics"><div class="command-metric"><span>On duty</span><b><%= center.counts.onDuty %></b><small>Live FiveM units</small></div><div class="command-metric"><span>Coverage alerts</span><b><%= center.counts.alerts %></b><small>Department readiness</small></div><div class="command-metric"><span>Pending leave</span><b><%= center.counts.loa %></b><small>Awaiting command</small></div><div class="command-metric"><span>Below activity</span><b><%= center.counts.activity %></b><small>7-day requirement</small></div><div class="command-metric"><span>FiveM players</span><b><%= center.counts.players %></b><small><%= center.counts.serversDown %> server(s) down</small></div></nav><% if(center.alerts.length){ %><section class="panel"><div class="panel-heading"><div><div class="eyebrow">COMMAND ALERTS</div><h2>Coverage needs attention</h2></div><a href="/command-center/readiness">Readiness board ↗</a></div><% center.alerts.forEach(a=>{ %><article class="people-row"><div><strong><%= a.title %></strong><small><%= a.message %></small></div><span class="status-badge <%= a.severity==='critical'?'offline':'' %>"><%= a.severity %></span></article><% }) %></section><% } %><div class="split"><main><section class="panel"><div class="panel-heading"><div><div class="eyebrow">LIVE OPERATIONS</div><h2>Units on duty</h2></div><a href="/command-center/readiness">Staffing targets ↗</a></div><% center.units.forEach(u=>{ %><article class="people-row"><div><strong><%= u.callsign?u.callsign+' · ':'' %><%= u.player_name||'Unknown unit' %></strong><small><%= u.department||'Unassigned' %><%= u.rank_name?' · '+u.rank_name:'' %></small></div><span class="pill"><%= u.duty_status||'available' %></span></article><% }) %><% if(!center.units.length){ %><p class="muted">No active FiveM units have checked in during the last 90 seconds.</p><% } %></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">NEEDS ATTENTION</div><h2>Personnel exceptions</h2></div><a href="/staff-activity">Open roster ↗</a></div><% if(!center.activity.length&&!center.probation.length&&!center.certifications.length){ %><p class="muted">No personnel exceptions need attention.</p><% } %><% center.activity.forEach(m=>{ %><article class="people-row"><div><a href="/personnel/<%= m.id %>"><strong><%= m.callsign?m.callsign+' · ':'' %><%= m.display_name||m.discord_username %></strong></a><small><%= m.department_name||'Unassigned' %> · <%= (Number(m.patrol_minutes)/60).toFixed(1) %>h / <%= (Number(m.activity_requirement_minutes)/60).toFixed(1) %>h</small></div><span class="status-badge offline">Below activity</span></article><% }) %><% center.probation.forEach(m=>{ %><article class="people-row"><div><a href="/personnel/<%= m.id %>"><strong><%= m.callsign?m.callsign+' · ':'' %><%= m.display_name||m.discord_username %></strong></a><small><%= m.department_name||'Unassigned' %></small></div><span class="pill">Probation ends <%= new Date(m.probation_ends_at).toLocaleDateString() %></span></article><% }) %><% center.certifications.forEach(m=>{ %><article class="people-row"><div><a href="/personnel/<%= m.id %>"><strong><%= m.display_name||m.discord_username %></strong></a><small><%= m.certification_name %></small></div><span class="pill">Expires <%= new Date(m.expires_at).toLocaleDateString() %></span></article><% }) %></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">RECRUITMENT</div><h2>Pipeline</h2></div><span class="muted"><%= center.recruits.length %> in progress</span></div><% center.recruits.forEach(r=>{ %><article class="people-row"><div><a href="/personnel/<%= r.id %>"><strong><%= r.callsign?r.callsign+' · ':'' %><%= r.display_name||r.discord_username %></strong></a><small><%= r.department_name||'Unassigned' %></small></div><span class="pill"><%= r.stage %></span></article><% }) %><% if(!center.recruits.length){ %><p class="muted">No recruits currently require progression.</p><% } %></section></main><aside><section class="panel"><div class="panel-heading"><div><div class="eyebrow">LEAVE</div><h2>Awaiting approval</h2></div><a href="/loa-management">Review all ↗</a></div><% center.loa.forEach(l=>{ %><article class="review-answer"><strong><%= l.callsign?l.callsign+' · ':'' %><%= l.display_name||l.discord_username %></strong><small><%= new Date(l.start_date).toLocaleDateString() %> – <%= new Date(l.end_date).toLocaleDateString() %></small><p><%= l.reason||'No reason provided.' %></p></article><% }) %><% if(!center.loa.length){ %><p class="muted">Leave queue is clear.</p><% } %></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">NEXT 7 DAYS</div><h2>Training</h2></div><a href="/training">Training center ↗</a></div><% center.training.forEach(t=>{ %><article class="people-row"><div><strong><%= t.title %></strong><small><%= t.department_name||'Community' %> · <%= new Date(t.start_at).toLocaleString() %></small></div><span class="pill"><%= t.roster_count %> registered</span></article><% }) %><% if(!center.training.length){ %><p class="muted">No training scheduled in the next seven days.</p><% } %></section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">FIVEM</div><h2>Server operations</h2></div><a href="/fivem/status">Status ↗</a></div><% center.servers.forEach(s=>{ %><article class="people-row"><div><strong><%= s.name %></strong><small><%= s.current_players||0 %>/<%= s.max_players||0 %> players</small></div><span class="status-badge <%= Number(s.live)?'online':'offline' %>"><%= Number(s.live)?'Online':'Offline' %></span></article><% }) %><% if(!center.servers.length){ %><p class="muted">No FiveM servers configured.</p><% } %></section><section class="panel"><div class="eyebrow">WORK QUEUES</div><h2>Community workload</h2><div class="people-summary"><div><span>Applications</span><strong><%= center.counts.applications %></strong></div><div><span>Reports</span><strong><%= center.counts.reports %></strong></div></div></section></aside></div>
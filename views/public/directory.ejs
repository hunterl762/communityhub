<%- include('../partials/header') %>
<section class="page-head"><div><div class="eyebrow">OUR COMMUNITY</div><h1><%= profile?'Member profile':'Member directory' %></h1><p>Meet the people in our community and departments.</p></div><% if(profile){ %><a class="btn secondary" href="/personnel">Back to directory</a><% } %></section>
<section class="panel"><div class="admin-list"><% members.forEach(m=>{ %><a class="admin-row" href="/personnel/<%= m.id %>"><%- include('../partials/account-avatar',{person:m}) %><div><strong><%= m.callsign?m.callsign+' · ':'' %><%= m.display_name||'Community member' %></strong><div class="muted"><%= m.department_name||'Community' %><%= m.rank_name?' · '+m.rank_name:'' %></div></div></a><% }) %><% if(profile&&members[0]?.bio){ %><article class="member-bio"><h2>About me</h2><p class="community-text"><%= members[0].bio %></p></article><% } %><% if(!members.length){ %><p class="muted">No community members are listed yet.</p><% } %></div></section>
<%- include('../partials/footer') %>

<%- include('../partials/header') %><section class="page-head"><div><div class="eyebrow"><%= communityName %></div><h1><%= publicContent.gallery_title %></h1><p><%= publicContent.gallery_body %></p></div></section><% if(!images.length){ %><section class="panel"><h2>More moments to come</h2><p class="muted">Community photos will appear here when they are published.</p></section><% } %><div class="community-gallery"><% images.forEach(image=>{ %><figure class="panel"><a href="/gallery/image/<%= image.id %>?v=<%= image.sha256 %>" target="_blank" rel="noopener"><img src="/gallery/image/<%= image.id %>?v=<%= image.sha256 %>" alt="<%= image.title %>" loading="lazy"></a><figcaption><h2><%= image.title %></h2><p><%= image.caption %></p></figcaption></figure><% }) %></div><%- include('../partials/footer') %>

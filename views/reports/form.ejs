<%- include('../partials/header') %><section class="panel narrow"><h1>Roleplay Report Center</h1><p>Report rule violations or incidents for staff review. Include clear details and evidence when available.</p><form method="post"><label><span>Report Type *</span><select name="report_type" required><% types.forEach(t=>{ %><option><%= t %></option><% }) %></select></label><label><span>Reported Player / Staff Name</span><input name="reported_name"></label><label><span>Date & Time</span><input type="datetime-local" name="occurred_at"></label><label><span>What happened? *</span><textarea name="description" required></textarea></label><label><span>Evidence URL</span><input type="url" name="evidence_url" placeholder="Clip, screenshot, stream VOD, etc."></label><button class="btn">Submit Report</button></form></section><%- include('../partials/footer') %>
<%- include('partials/header') %><% const c=typeof publicContent!=='undefined'?publicContent:{"description":"A connected FiveM roleplay community. Explore our departments, events and community stories.","public_url":"","hero_title":"A community built for meaningful roleplay.","hero_body":"Find your department. Build your skills. Stay connected to the people and operations that make your community.","side_title":"From your first application to your next patrol.","highlights":"Apply and find your place\nTrain with your department\nTake part in live operations","section_title":"Our community","section_body":"Meet new people, create memorable stories and find your place in our community.","cta_title":"Your next chapter starts here.","cta_body":"Connect your Discord account and join the community workspace.","cta_label":"Continue with Discord","cta_url":"/auth/login","about_title":"About our community","about_body":"We bring players together through meaningful roleplay, shared training and community events.","gallery_title":"Community gallery","gallery_body":"Stories and moments from our community.","show_stats":true,"show_resources":true,"show_section":true,"show_cta":true}; %><section class="public-hero"><div><div class="eyebrow">WELCOME TO <%= communityName %></div><h1><%= c.hero_title %></h1><p><%= c.hero_body %></p><div class="actions"><a class="btn" href="/applications">Apply to the community ↗</a><a class="btn secondary" href="/auth/login">Member sign in</a></div></div><aside class="public-seal-panel"><div class="eyebrow">YOUR COMMUNITY, CONNECTED</div><h2><%= c.side_title %></h2><ol><% c.highlights.split(/\r?\n/).filter(Boolean).slice(0,3).forEach((text,i)=>{ %><li><span><%= String(i+1).padStart(2,"0") %></span><%= text %></li><% }) %></ol></aside></section><% if(c.show_stats){ %><section class="stats" aria-label="Community activity"><div><span class="public-stat-label">Recruitment</span><b><%= stats.applications %></b><span>Applications received</span></div><div><span class="public-stat-label">Community support</span><b><%= stats.reports %></b><span>Reports submitted</span></div><div><span class="public-stat-label">Upcoming schedule</span><b><%= stats.events %></b><span>Community events</span></div><div><span class="public-stat-label">Knowledge library</span><b><%= stats.documents %></b><span>Shared documents</span></div></section><% } %><% if(c.show_section){ %><section class="panel public-copy"><h2><%= c.section_title %></h2><p><%= c.section_body %></p><a class="tool-link" href="/about">Learn about us →</a></section><% } %><% if(c.show_resources){ %><section id="community"><div class="section-heading"><div><div class="eyebrow">ONE CONNECTED COMMUNITY</div><h2>Everything you need to take part.</h2></div><p class="muted">Community resources are available after sign-in.</p></div><div class="grid"><a class="card" href="/applications"><%- include('partials/ui-icon',{name:'file'}) %><h2>Recruitment</h2><p>Explore department and community applications.</p><span class="tool-link">Find your place ↗</span></a><a class="card" href="/training"><%- include('partials/ui-icon',{name:'calendar'}) %><h2>Training</h2><p>Develop your skills and join department sessions.</p><span class="tool-link">View training ↗</span></a><a class="card" href="/documents"><%- include('partials/ui-icon',{name:'folder'}) %><h2>Resources</h2><p>Access policies, procedures and training material.</p><span class="tool-link">Open the library ↗</span></a><a class="card" href="/fivem/status"><%- include('partials/ui-icon',{name:'signal'}) %><h2>Live operations</h2><p>Stay informed with server status and patrol activity.</p><span class="tool-link">Sign in to view status ↗</span></a></div></section><% } %><% if(c.show_cta){ %><section class="public-cta"><div><h2><%= c.cta_title %></h2><p><%= c.cta_body %></p></div><a class="btn" href="<%= c.cta_url %>"><%= c.cta_label %> ↗</a></section><% } %><%- include('partials/footer') %>

<%- include('../partials/header') %><div class="<%= canManage?'split':'' %>"><section><h1>Training & Community Calendar</h1><p class="lead">Upcoming trainings, interviews, patrols, meetings and community events.</p><div class="timeline"><% events.forEach(e=>{ %><article class="event"><time><%= new Date(e.start_at).toLocaleString() %></time><div><span class="pill"><%= e.event_type %></span><h2><%= e.title %></h2><p><%= e.description||'' %></p><small><%= e.location||'' %></small></div></article><% }) %></div></section><% if(canManage){ %><aside class="panel"><h2>Schedule Event</h2><p class="muted">Available to Department Command and community staff.</p><form method="post" action="/calendar/admin/events"><label><span>Title</span><input name="title" required></label><label><span>Type</span><select name="event_type"><option value="training">Training</option><option value="interview">Interview</option><option value="patrol">Patrol</option><option value="meeting">Meeting</option><option value="community">Community Event</option></select></label><label><span>Starts</span><input type="datetime-local" name="start_at" required></label><label><span>Ends</span><input type="datetime-local" name="end_at"></label><label><span>Location</span><input name="location"></label><label><span>Description</span><textarea name="description"></textarea></label><button class="btn">Schedule</button></form></aside><% } %></div><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="panel auth-panel"><div class="eyebrow">EMAIL VERIFICATION</div><h1>Check your inbox</h1><% if(sent){ %><div class="alert success">We sent a verification link to <strong><%= user.email %></strong>.</div><p>The link expires in 60 minutes. Open it to verify your Community Hub email address.</p><% }else{ %><div class="alert">Your account was created, but the verification email could not be sent. Check the SMTP configuration and try again.</div><% } %><form method="post" action="/auth/resend-verification"><button class="btn secondary" type="submit">Resend Verification Email</button></form><p><a href="/account">Return to Account Settings</a></p></section><%- include('../partials/footer') %>
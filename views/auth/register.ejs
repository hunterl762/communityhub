<%- include('../partials/header') %><section class="panel auth-panel"><div class="eyebrow">CREATE ACCOUNT</div><h1>Join Community Hub</h1><p>Create an email account now. You can link your Discord account from Account Settings afterward.</p><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="/auth/register" class="form-grid"><label>Username<input type="text" name="username" maxlength="100" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" required></label><button class="btn" type="submit">Create Account</button></form><div class="auth-divider"><span>or</span></div><a class="btn discord-btn" href="/auth/discord">Create account with Discord</a><p class="muted">Already registered? <a href="/auth/login">Sign in</a></p></section><%- include('../partials/footer') %>
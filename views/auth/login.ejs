<%- include('../partials/header') %><section class="panel auth-panel"><div class="eyebrow">COMMUNITY ACCESS</div><h1>Sign in</h1><p>Use Discord for quick access, or sign in with your Community Hub email account.</p><% if(error){ %><div class="alert"><%= error %></div><% } %><a class="btn discord-btn" href="/auth/discord">Continue with Discord</a><div class="auth-divider"><span>or</span></div><form method="post" action="/auth/login" class="form-grid"><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn" type="submit">Sign in with Email</button></form><p class="muted">Don't have an account? <a href="/auth/register">Create one</a></p></section><%- include('../partials/footer') %>
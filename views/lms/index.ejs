<%- include('../partials/header') %><section class="page-head"><div><p class="eyebrow">Training</p><h1>My Training</h1><p>Courses assigned to you, current progress and available training.</p></div><% if(canManage){ %><a class="btn secondary" href="/lms/admin">Manage courses</a><% } %></section><section class="panel"><div class="panel-heading"><div><h2>Current training</h2><p class="muted">Continue where you left off.</p></div></div><div class="table-scroll"><table class="community-table"><thead><tr><th>Course</th><th>Department</th><th>Status</th><th>Progress</th><th></th></tr></thead><tbody><% mine.filter(x=>x.status!=='completed').forEach(c=>{ %><tr><td><strong><%= c.title %></strong></td><td><%= c.department_name||'Community-wide' %></td><td><%= c.status.replaceAll('_',' ') %></td><td><%= Number(c.progress_percent||0).toFixed(0) %>%</td><td><a href="/lms/courses/<%= c.course_id %>">Continue</a></td></tr><% }) %></tbody></table></div><% if(!mine.some(x=>x.status!=='completed')){ %><p class="muted">You do not have any training in progress.</p><% } %></section><section class="panel"><div class="panel-heading"><div><h2>Course catalog</h2><p class="muted">Published courses available to community members.</p></div></div><div class="course-list"><% courses.forEach(c=>{ %><article class="course-row"><div><strong><%= c.title %></strong><p><%= c.description||'No course description has been provided.' %></p><small><%= c.department_name||'Community-wide' %><%= c.estimated_minutes?' · About '+c.estimated_minutes+' minutes':'' %></small></div><div><% if(c.enrollment_status){ %><a class="btn secondary" href="/lms/courses/<%= c.id %>"><%= c.enrollment_status==='completed'?'Review':'Continue' %></a><% }else{ %><form method="post" action="/lms/courses/<%= c.id %>/enroll"><button class="btn">Start course</button></form><% } %></div></article><% }) %><% if(!courses.length){ %><p class="muted">There are no published courses at this time.</p><% } %></div></section><% if(mine.some(x=>x.status==='completed')){ %><section class="panel"><div class="panel-heading"><div><h2>Completed training</h2></div></div><% mine.filter(x=>x.status==='completed').forEach(c=>{ %><article class="people-row"><div><strong><%= c.title %></strong><small><%= c.department_name||'Community-wide' %></small></div><span>Completed<%= c.final_score!=null?' · '+Number(c.final_score).toFixed(0)+'%':'' %></span></article><% }) %></section><% } %><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><p class="eyebrow">Training / Course</p><h1><%= course.title %></h1><p><%= course.description||'Course materials and completion requirements.' %></p></div><a class="btn secondary" href="/lms">← My Training</a></section><div class="training-layout"><aside class="panel training-outline"><strong>Course outline</strong><% modules.forEach(m=>{ %><div class="training-module"><span><%= m.title %></span><% lessons.filter(l=>l.module_id===m.id).forEach(l=>{ %><a href="#lesson-<%= l.id %>"><%= l.progress_status==='completed'?'✓ ':'' %><%= l.title %></a><% }) %></div><% }) %></aside><main><section class="panel"><div class="people-summary"><div><span>Status</span><strong><%= course.enrollment_status?course.enrollment_status.replaceAll('_',' '):'Not enrolled' %></strong></div><div><span>Progress</span><strong><%= Number(course.progress_percent||0).toFixed(0) %>%</strong></div><div><span>Estimated time</span><strong><%= course.estimated_minutes?course.estimated_minutes+' min':'—' %></strong></div></div><% if(!course.enrollment_id&&course.status==='published'){ %><form method="post" action="/lms/courses/<%= course.id %>/enroll"><button class="btn">Start this course</button></form><% } %></section><% modules.forEach(m=>{ %><section class="panel"><div class="panel-heading"><div><h2><%= m.title %></h2><% if(m.description){ %><p class="muted"><%= m.description %></p><% } %></div></div><% lessons.filter(l=>l.module_id===m.id).forEach(l=>{ %><article class="lesson" id="lesson-<%= l.id %>"><div class="panel-heading"><div><strong><%= l.title %></strong><small><%= l.lesson_type %><%= l.estimated_minutes?' · '+l.estimated_minutes+' min':'' %></small></div><span><%= l.progress_status==='completed'?'Completed':l.is_required?'Required':'Optional' %></span></div><% if(l.content){ %><div class="lesson-content"><%= l.content %></div><% } %><% if(l.resource_url){ %><a href="<%= l.resource_url %>" target="_blank" rel="noopener">Open course resource ↗</a><% } %><% if(course.enrollment_id&&l.lesson_type!=='quiz'&&l.progress_status!=='completed'){ %><form method="post" action="/lms/courses/<%= course.id %>/lessons/<%= l.id %>/complete"><button class="btn secondary">Mark complete</button></form><% } %><% if(l.lesson_type==='quiz'){ %><p class="muted">Assessment questions will appear here once configured.</p><% } %></article><% }) %></section><% }) %></main></div><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><p class="eyebrow">Training / Course Builder</p><h1><%= course.title %></h1><p>Build the course in the order members will complete it.</p></div><div class="actions"><a class="btn secondary" href="/lms/courses/<%= course.id %>">Preview</a><a class="btn secondary" href="/lms/admin">← Courses</a></div></section><div class="training-builder"><div class="training-content"><% modules.forEach((m,i)=>{ %><section class="panel"><div class="panel-heading"><div><small>Module <%= i+1 %></small><h2><%= m.title %></h2><% if(m.description){ %><p class="muted"><%= m.description %></p><% } %></div></div><% lessons.filter(l=>l.module_id===m.id).forEach((l,n)=>{ %><article class="people-row"><div><strong><%= i+1 %>.<%= n+1 %> <%= l.title %></strong><small><%= l.lesson_type %><%= l.estimated_minutes?' · '+l.estimated_minutes+' minutes':'' %><%= l.is_required?' · required':' · optional' %></small></div></article><% if(l.lesson_type==='quiz'){const a=assessments[l.id]; %><ol><% a.questions.forEach(q=>{ %><li><strong><%= q.question_text %></strong> · <%= q.points %> points<ol><% a.answers.filter(x=>x.question_id===q.id).forEach(x=>{ %><li><%= x.answer_text %><%= Number(x.is_correct)?' (correct)':'' %></li><% }) %></ol></li><% }) %></ol><% if(course.status==='draft'){ %><details><summary>Add assessment question</summary><form method="post" action="/lms/admin/courses/<%= course.id %>/lessons/<%= l.id %>/questions"><label>Question<textarea name="question_text" required maxlength="4000"></textarea></label><label>Type<select name="question_type"><option value="single">Single choice</option><option value="true_false">True / false</option></select></label><label>Choices, one per line (single choice only)<textarea name="choices" rows="4"></textarea></label><label>Correct choice number (True = 1, False = 2)<input name="correct_choice" type="number" min="1" max="8" required></label><label>Points<input name="points" type="number" min="0.01" max="1000" step="0.01" value="1" required></label><button class="btn secondary">Add question</button></form></details><% }else{ %><p class="muted">Set this course to draft to change its questions.</p><% } %><% } %><% }) %><details><summary>Add lesson</summary><form method="post" action="/lms/admin/courses/<%= course.id %>/modules/<%= m.id %>/lessons"><label><span>Lesson title</span><input name="title" required></label><label><span>Type</span><select name="lesson_type"><option value="content">Written content</option><option value="video">Video</option><option value="resource">Resource / document</option><option value="quiz">Assessment</option></select></label><label><span>Lesson content</span><textarea name="content" rows="7"></textarea></label><label><span>Resource URL</span><input name="resource_url"></label><label><span>Estimated minutes</span><input type="number" min="1" name="estimated_minutes"></label><label><input type="checkbox" name="is_required" value="1" checked> Required for completion</label><button class="btn secondary">Add lesson</button></form></details></section><% }) %><section class="panel"><h2>Add module</h2><form method="post" action="/lms/admin/courses/<%= course.id %>/modules"><label><span>Module title</span><input name="title" required></label><label><span>Description</span><textarea name="description" rows="3"></textarea></label><button class="btn secondary">Add module</button></form></section></div><aside><section class="panel"><h2>Course settings</h2><form method="post" action="/lms/admin/courses/<%= course.id %>/settings"><label><span>Title</span><input name="title" value="<%= course.title %>" required></label><label><span>Description</span><textarea name="description" rows="6"><%= course.description||'' %></textarea></label><label><span>Status</span><select name="status"><% ['draft','published','archived'].forEach(s=>{ %><option value="<%= s %>" <%= course.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label><span>Estimated minutes</span><input type="number" min="1" name="estimated_minutes" value="<%= course.estimated_minutes||'' %>"></label><label><span>Passing score</span><input type="number" min="0" max="100" step="0.01" name="passing_score" value="<%= course.passing_score??'' %>"></label><label>Certification<select name="certification_id"><option value="">No certification</option><% certifications.forEach(c=>{ %><option value="<%= c.id %>" <%= String(c.id)===String(course.certification_id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Certification validity in days (blank = no expiry)<input name="certificate_valid_days" type="number" min="1" max="36500" value="<%= course.certificate_valid_days||'' %>"></label><p class="muted">Assessments use 70% when no passing score is set. A course needs required lessons and configured assessments before publication.</p><button class="btn">Save settings</button></form></section></aside></div><%- include('../partials/footer') %>
<%- include('../partials/header') %><section class="page-head"><div><p class="eyebrow">Training / Administration</p><h1>Courses</h1><p>Create and maintain the training available to your community.</p></div><a class="btn secondary" href="/lms">My Training</a></section><div class="split"><main><section class="panel"><div class="panel-heading"><div><h2>Course library</h2><p class="muted"><%= courses.length %> course<%= courses.length===1?'':'s' %></p></div></div><div class="table-scroll"><table class="community-table"><thead><tr><th>Course</th><th>Department</th><th>Status</th><th>Modules</th><th>Enrollments</th><th></th></tr></thead><tbody><% courses.forEach(c=>{ %><tr><td><strong><%= c.title %></strong></td><td><%= c.department_name||'Community-wide' %></td><td><%= c.status %></td><td><%= c.module_count %></td><td><%= c.enrollment_count %></td><td><a href="/lms/admin/courses/<%= c.id %>">Edit</a></td></tr><% }) %></tbody></table></div></section></main><aside><section class="panel"><h2>New course</h2><form method="post" action="/lms/admin/courses"><label><span>Course title</span><input name="title" required></label><label><span>Department</span><select name="department_id"><option value="">Community-wide</option><% departments.forEach(d=>{ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></label><label><span>Description</span><textarea name="description" rows="5"></textarea></label><div class="form-grid"><label><span>Estimated minutes</span><input type="number" min="1" name="estimated_minutes"></label><label><span>Passing score</span><input type="number" min="0" max="100" name="passing_score"></label></div><label><span>Certification on completion</span><select name="certification_id"><option value="">None</option><% certifications.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label><span>Certification valid for (days)</span><input type="number" min="1" name="certificate_valid_days"></label><button class="btn">Create course</button></form></section></aside></div><%- include('../partials/footer') %>
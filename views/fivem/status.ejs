<%- include('../partials/header') %>
<section class="page-head"><div><div class="eyebrow">COMMUNITY SERVER STATUS</div><h1>FiveM service status</h1><p>Live player counts and recorded uptime for your community servers.</p></div><a class="btn secondary" href="/fivem">FiveM account & patrol</a></section>
<section data-live-url="/fivem/status/data" data-live-status class="status-workspace">
<div class="live-caption"><span class="live-dot"></span><span data-live-notice role="status">Updates every 15 seconds</span></div>
<div class="grid two" data-server-cards>
<% snapshot.servers.forEach(s=>{ const total=Number(s.online_seconds)+Number(s.offline_seconds); %>
<article class="panel"><div class="server-title"><h2><%= s.name %></h2><span class="status-badge <%= s.live?'online':'offline' %>"><%= s.live?'Operational':'Offline' %></span></div><p><%= s.current_players %> / <%= s.max_players %> players</p><dl class="server-meta"><div><dt>Recorded uptime · 30 days</dt><dd><%= total?(100*Number(s.online_seconds)/total).toFixed(2)+'%':'Collecting data' %></dd></div><div><dt>Online time</dt><dd><%= duration(s.online_seconds) %></dd></div><div><dt>Offline time</dt><dd><%= duration(s.offline_seconds) %></dd></div></dl><p class="muted">Last heartbeat: <%= s.last_heartbeat_at?new Date(s.last_heartbeat_at).toLocaleString():'Not received' %></p><small>History begins: <%= s.tracked_since?new Date(s.tracked_since).toLocaleString():'Not yet recorded' %></small></article>
<% }) %><% if(!snapshot.servers.length){ %><p class="panel muted">No community servers are configured yet.</p><% } %>
</div><section class="panel admin-section"><h2>Availability history</h2><p class="muted">Recent online and offline periods from the last 30 days. An outage begins 90 seconds after the last heartbeat; detection runs every 15 seconds. History starts when monitoring is installed, and includes only observed time.</p><div data-status-history class="status-history"><% snapshot.history.forEach(p=>{ %><article class="history-row"><div><strong><%= p.server_name %></strong><span class="status-badge <%= p.state %>"><%= p.state==='online'?'Operational':'Offline' %></span></div><p><%= new Date(p.started_at).toLocaleString() %> → <%= p.ended_at?new Date(p.ended_at).toLocaleString():'Ongoing' %></p><small><%= duration(p.duration_seconds) %></small></article><% }) %><% if(!snapshot.history.length){ %><p class="muted">No status history yet.</p><% } %></div></section>
</section><script src="/js/live.js" defer></script><%- include('../partials/footer') %>

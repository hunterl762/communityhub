<%- include('../partials/header') %><section class="panel narrow"><h1><%= form.title %></h1><p><%= form.description||'' %></p><% if(!guildMember){ %><div class="alert">Join the community Discord server before submitting this application, then refresh this page.</div><% }else{ %><div class="alert success">Discord membership verified.</div><form method="post"><% questions.forEach(q=>{let opts=[];try{opts=Array.isArray(q.options_json)?q.options_json:JSON.parse(q.options_json||'[]')}catch{}if(!Array.isArray(opts))opts=[]; %><fieldset><legend><%= q.label %><%= q.is_required?' *':'' %></legend><% if(['checkbox','radio'].includes(q.question_type)){opts.forEach(o=>{ %><label class="checkbox-label"><input name="q_<%= q.id %>" type="<%= q.question_type %>" value="<%= o %>" <%= q.is_required&&q.question_type==='radio'?'required':'' %>><span><%= o %></span></label><% });}else if(q.question_type==='textarea'){ %><textarea name="q_<%= q.id %>" maxlength="10000" <%= q.is_required?'required':'' %> aria-label="<%= q.label %>"></textarea><% }else if(q.question_type==='select'){ %><select name="q_<%= q.id %>" <%= q.is_required?'required':'' %> aria-label="<%= q.label %>"><option value="">Select…</option><% opts.forEach(o=>{ %><option><%= o %></option><% }) %></select><% }else{ %><input type="<%= ['number','date','url','email'].includes(q.question_type)?q.question_type:'text' %>" name="q_<%= q.id %>" step="any" maxlength="10000" value="<%= q.prefill_value||'' %>" <%= q.account_identity?'readonly':'' %> <%= q.is_required?'required':'' %> aria-label="<%= q.label %>"><% } %><small><%= q.account_identity?'Filled from your connected Discord account.':q.help_text||'' %></small></fieldset><% }) %><button class="btn">Submit application</button></form><% } %></section><%- include('../partials/footer') %>

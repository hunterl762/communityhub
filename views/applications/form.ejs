<%- include('../partials/header') %><section class="panel narrow"><h1><%= form.title %></h1><p><%= form.description||'' %></p><% if(!guildMember){ %><div class="alert">You must be a member of the community Discord server before you can submit this application.</div><p class="muted">Join the Discord server, then refresh this page. Community Hub verifies membership using your signed-in Discord account.</p><% }else{ %><div class="alert success">Discord server membership verified.</div><form method="post"><% questions.forEach(q=>{ %><label><span><%= q.label %><%= q.is_required?' *':'' %></span><% if(q.question_type==='textarea'){ %><textarea name="q_<%= q.id %>" <%= q.is_required?'required':'' %>></textarea><% } else if(q.question_type==='select'){ let opts=[];try{opts=JSON.parse(q.options_json||'[]')}catch{} %><select name="q_<%= q.id %>" <%= q.is_required?'required':'' %>><option value="">Select...</option><% opts.forEach(o=>{ %><option><%= o %></option><% }) %></select><% } else { %><input type="<%= q.question_type==='number'?'number':'text' %>" name="q_<%= q.id %>" <%= q.is_required?'required':'' %>><% } %><small><%= q.help_text||'' %></small></label><% }) %><button class="btn" type="submit">Submit Application</button></form><% } %></section><%- include('../partials/footer') %>
<%- include('../partials/header') %><h1>Community Applications</h1><p class="lead">Choose an open application below.</p><section class="grid"><% forms.forEach(f=>{ %><a class="card" href="/applications/<%= f.slug %>"><h2><%= f.title %></h2><p><%= f.description||'Submit your application for staff review.' %></p><span class="pill">Open</span></a><% }) %><% if(!forms.length){ %><div class="card">No applications are currently open.</div><% } %></section><%- include('../partials/footer') %>
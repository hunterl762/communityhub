<%- include('../partials/header') %>
<div class="<%= canManage?'split':'' %>"><section><div class="page-head"><div><div class="eyebrow">COMMUNITY RESOURCES</div><h1>Document library</h1><p>Files, policies and department resources in one place.</p></div></div>
<div class="grid document-grid"><% docs.forEach(d=>{ %><article class="card"><span class="pill"><%= d.folder_name||'General' %></span><h2><%= d.title %></h2><p><%= d.original_name %> · <%= Math.ceil(d.file_size/1024) %> KB · <%= d.database_stored?'Database':'Legacy file' %></p><div class="document-actions"><a class="btn secondary" href="/documents/<%= d.id %>/download">Download</a><% if(canRemove){ %><form method="post" action="/documents/<%= d.id %>/remove"><button class="btn secondary">Remove</button></form><% } %></div></article><% }) %></div><% if(!docs.length){ %><p class="empty-state">No documents are available yet.</p><% } %>
<% if(canRemove){ %><details class="panel admin-section"><summary>Removed documents (<%= removedDocs.length %>)</summary><p class="muted">Removed files are hidden from the library and cannot be downloaded. Admins can restore them here.</p><div class="admin-list"><% removedDocs.forEach(d=>{ %><article class="admin-row"><div><strong><%= d.title %></strong><p class="muted"><%= d.original_name %> · Removed <%= new Date(d.deleted_at).toLocaleString() %></p></div><form method="post" action="/documents/<%= d.id %>/restore"><button class="btn secondary">Restore</button></form></article><% }) %><% if(!removedDocs.length){ %><p class="muted">No removed documents.</p><% } %></div></details><% } %></section>
<% if(canManage){ %><aside class="panel"><h2>Upload a file</h2><p class="muted">All file types are supported, including archives, videos and script files. Maximum upload: <%= maxUploadMB %> MB per file.</p><p class="muted">Files are stored in the community database and downloaded as attachments.</p><form method="post" action="/documents/upload" enctype="multipart/form-data"><label><span>Title</span><input name="title" maxlength="255"></label><label><span>Folder</span><select name="folder_id"><option value="">General</option><% folders.forEach(f=>{ %><option value="<%= f.id %>"><%= f.name %></option><% }) %></select></label><label><span>File</span><input type="file" name="document" required></label><button class="btn">Upload file</button></form></aside><% } %></div>
<%- include('../partials/footer') %>

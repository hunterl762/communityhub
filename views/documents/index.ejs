<%- include('../partials/header') %><div class="split"><section><h1>Staff Document Hub</h1><p class="lead">Central storage for SOPs, policies, training material and department resources.</p><div class="grid"><% docs.forEach(d=>{ %><article class="card"><span class="pill"><%= d.folder_name||'General' %></span><h2><%= d.title %></h2><p><%= d.original_name %> • <%= Math.ceil(d.file_size/1024) %> KB</p><a class="btn secondary" href="/documents/<%= d.id %>/download">Download</a></article><% }) %></div></section><aside class="panel"><h2>Admin: Upload</h2><form method="post" action="/documents/upload" enctype="multipart/form-data"><label><span>Title</span><input name="title"></label><label><span>Folder</span><select name="folder_id"><option value="">General</option><% folders.forEach(f=>{ %><option value="<%= f.id %>"><%= f.name %></option><% }) %></select></label><label><span>Document</span><input type="file" name="document" required></label><button class="btn">Upload Document</button></form></aside></div><%- include('../partials/footer') %>